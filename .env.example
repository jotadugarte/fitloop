# Copy to .env and adjust for your local PostgreSQL (WSL).
# Production: set ENV on the Linux VM host — see docs/DEPLOY.md and ADR-0007 (not Northflank/Docker v1 path).
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres

# Billing geo (local/WSL without Cloudflare): force country for prices (CR = colones + IVA).
# bin/dev loads this file then defaults to CR; for abroad testing use US (restart server after change).
# FITLOOP_BILLING_COUNTRY_OVERRIDE=US
# Do NOT set FITLOOP_BILLING_COUNTRY_OVERRIDE in production.

# GeoLite2 Country MMDB fallback (production recommended). Download once:
#   MAXMIND_LICENSE_KEY=... bin/rails billing:geo:install_geolite2
# GEOLITE2_COUNTRY_MMDB_PATH=storage/geoip/GeoLite2-Country.mmdb

# OAuth (optional in development; Google button works with dev stubs without these)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# Billing gateway: simulate (demo buttons) | onvo (live ONVO Payment Intents)
# BILLING_GATEWAY=simulate

# ONVO (test keys from ONVO dashboard; required when BILLING_GATEWAY=onvo)
# ONVO_MODE=test
# ONVO_SECRET_KEY=onvo_test_secret_...
# ONVO_PUBLISHABLE_KEY=onvo_test_publishable_...
# ONVO_WEBHOOK_SECRET=whsec_...

# Admin configuration
FITLOOP_ADMIN_EMAILS=you@example.com,partner@example.com

