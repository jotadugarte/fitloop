# Copy to .env and adjust for your local PostgreSQL (WSL).
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres

# OAuth (optional in development; Google button works with dev stubs without these)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
