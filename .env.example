# Copy to .env and adjust for your local PostgreSQL (WSL).
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres

# Billing geo (local/WSL without Cloudflare): force country for prices (CR = colones + IVA).
# bin/dev sets CR by default; override for international testing, e.g. FITLOOP_BILLING_COUNTRY_OVERRIDE=US
# FITLOOP_BILLING_COUNTRY_OVERRIDE=CR

# OAuth (optional in development; Google button works with dev stubs without these)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# Billing gateway: simulate (demo buttons) | onvo (live ONVO Payment Intents)
# BILLING_GATEWAY=simulate

# ONVO (test keys from ONVO dashboard; required when BILLING_GATEWAY=onvo)
# ONVO_MODE=test
# ONVO_SECRET_KEY=onvo_test_secret_...
# ONVO_PUBLISHABLE_KEY=onvo_test_publishable_...
# ONVO_WEBHOOK_SECRET=whsec_...
