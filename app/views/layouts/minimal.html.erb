<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-controller="workspace-tab">
  <head>
    <title><%= content_for(:title) || t("application.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/images/minilogo.png" type="image/png">
    <link rel="apple-touch-icon" href="/images/minilogo.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="layout-minimal">
    <main class="minimal-layout minimal-layout--auth">
      <div class="minimal-layout__top minimal-layout__toolbar">
        <%= render "shared/app_toolbar" %>
      </div>
      <%= render "shared/flash" %>
      <%= render "shared/fitloop_dialog" %>
      <%= yield %>
    </main>
  </body>
</html>
