<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title>Fitloop Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/images/minilogo.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="layout-admin">
    <header class="admin-header" style="display: flex; justify-content: space-between; align-items: center; padding: 1rem 2rem; background: var(--bg-surface, #1e1e1e); border-bottom: 1px solid var(--border-color, #333); color: var(--text-color, #fff);">
      <div class="admin-header__brand">
        <%= link_to "Fitloop Admin", admin_root_path, style: "font-weight: 700; text-decoration: none; color: inherit; font-size: 1.25rem;" %>
      </div>
      <div class="admin-header__user" style="display: flex; align-items: center; gap: 1.5rem;">
        <% if user_signed_in? %>
          <span style="font-size: 0.9rem; opacity: 0.85;"><%= current_user.email %></span>
          <%= button_to t("auth.nav.sign_out"),
                destroy_user_session_path,
                method: :delete,
                class: "btn btn-secondary btn--compact",
                form: { data: { turbo: false } } %>
        <% end %>
      </div>
    </header>

    <main class="admin-main" style="padding: 2rem; max-width: 1200px; margin: 0 auto;">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
