<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title>Fitloop Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/images/minilogo.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="layout-admin">
    <header class="admin-header">
      <div class="admin-header__brand">
        <%= link_to "Fitloop Admin", admin_root_path %>
      </div>
      <div class="admin-header__user">
        <% if user_signed_in? %>
          <span class="admin-header__user-email"><%= current_user.email %></span>
          <%= button_to t("auth.nav.sign_out"),
                destroy_user_session_path,
                method: :delete,
                class: "btn btn-secondary btn--compact",
                form: { data: { turbo: false } } %>
        <% end %>
      </div>
    </header>

    <main class="admin-main">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>

