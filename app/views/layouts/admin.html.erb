<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title>moduSLoop Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/images/icono-modusloop.png" type="image/png" media="(prefers-color-scheme: light)">
    <link rel="icon" href="/images/icono-modusloop-dark.png" type="image/png" media="(prefers-color-scheme: dark)">
    <link rel="apple-touch-icon" href="/images/icono-modusloop.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="layout-admin">
    <header class="admin-header">
      <div class="admin-header__brand">
        <%= link_to "moduSLoop Admin", admin_root_path %>
        <nav class="admin-header__nav">
          <%= link_to "Inicio", admin_root_path, class: "admin-header__nav-link #{'admin-header__nav-link--active' if current_page?(admin_root_path)}" %>
          <%= link_to "Ventas", admin_ventas_path, class: "admin-header__nav-link #{'admin-header__nav-link--active' if request.path.start_with?('/admin/ventas')}" %>
          <%= link_to "Analytics", admin_analytics_path, class: "admin-header__nav-link #{'admin-header__nav-link--active' if request.path.start_with?('/admin/analytics')}" %>
          <%= link_to "Usuarios", admin_usuarios_path, class: "admin-header__nav-link #{'admin-header__nav-link--active' if request.path.start_with?('/admin/usuarios')}" %>
          <%= link_to "Feedback", admin_feedbacks_path, class: "admin-header__nav-link #{'admin-header__nav-link--active' if request.path.start_with?('/admin/feedbacks')}" %>
        </nav>
      </div>
      <div class="admin-header__user">
        <% if user_signed_in? %>
          <span class="admin-header__user-email"><%= current_user.email %></span>
          <%= link_to "← Ir a moduSLoop", root_path,
                class: "btn btn-secondary btn--compact",
                style: "opacity: 0.85; text-decoration: none;" %>
          <%= button_to t("auth.nav.sign_out"),
                destroy_user_session_path,
                method: :delete,
                class: "btn btn-secondary btn--compact",
                form: { data: { turbo: false } } %>
        <% end %>
      </div>
    </header>

    <main class="admin-main">
      <% if user_signed_in? && !current_user.confirmed? %>
        <div class="unconfirmed-banner" style="background-color: var(--fit-alert-bg, #fff5f5); border-bottom: 1px solid var(--fit-alert-border, #c45c5c); padding: 0.75rem 1rem; text-align: center; color: var(--fit-text, #1a2332); font-size: 0.9rem;">
          <span style="font-weight: 600; color: var(--fit-alert-border, #c45c5c);">Atención:</span>
          Debes confirmar tu correo electrónico para poder realizar pagos y descargas.
          <%= link_to "Reenviar correo", new_user_confirmation_path, style: "text-decoration: underline; font-weight: 500; margin-left: 0.5rem;" %>
        </div>
      <% end %>
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>

