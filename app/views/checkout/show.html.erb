<article data-testid="checkout-page">
  <p class="checkout-demo-badge" data-testid="checkout-demo" role="status">
    <%= t("billing.checkout.demo_badge") %>
  </p>

  <h1><%= t("billing.checkout.title") %></h1>

  <p data-testid="checkout-pricing">
    <%= t("billing.checkout.single_download") %>:
    USD <%= Billing::Pricing.single_download_usd %> /
    CRC <%= Billing::Pricing.single_download_sinpe_crc %>
  </p>

  <p data-testid="checkout-overage-pricing">
    <%= t("billing.checkout.overage_hint") %>:
    USD <%= Billing::Pricing.single_download_overage_usd %> /
    CRC <%= Billing::Pricing.single_download_overage_sinpe_crc %>
  </p>

  <p><%= t("billing.single_download.retention_24h") %></p>

  <section data-testid="checkout-pay-card-usd">
    <h2><%= t("billing.checkout.card_usd") %></h2>
    <%= form_with url: checkout_simulate_path, method: :post, data: { turbo: false } do %>
      <%= hidden_field_tag :nesting_run_id, @nesting_run.id %>
      <%= hidden_field_tag :payment_method, "card_usd" %>
      <div class="checkout-simulate-actions">
        <%= button_tag t("billing.checkout.simulate_success"), name: "outcome", value: "success", class: "btn btn-primary", data: { testid: "checkout-simulate-success" } %>
        <%= button_tag t("billing.checkout.simulate_failure"), name: "outcome", value: "failure", class: "btn btn-secondary", data: { testid: "checkout-simulate-failure" } %>
      </div>
    <% end %>
  </section>

  <section data-testid="checkout-pay-sinpe-crc">
    <h2><%= t("billing.checkout.sinpe_crc") %></h2>
    <%= form_with url: checkout_simulate_path, method: :post, data: { turbo: false } do %>
      <%= hidden_field_tag :nesting_run_id, @nesting_run.id %>
      <%= hidden_field_tag :payment_method, "sinpe_crc" %>
      <div class="checkout-simulate-actions">
        <%= button_tag t("billing.checkout.simulate_success"), name: "outcome", value: "success", class: "btn btn-primary", data: { testid: "checkout-simulate-success" } %>
        <%= button_tag t("billing.checkout.simulate_failure"), name: "outcome", value: "failure", class: "btn btn-secondary", data: { testid: "checkout-simulate-failure" } %>
      </div>
    <% end %>
  </section>

  <p>
    <%= link_to t("billing.checkout.download_now"), nested_dxf_project_path(@project), data: { testid: "checkout-download-now" } %>
  </p>
  <p><%= link_to t("billing.paywall.back_to_project"), project_path(@project) %></p>
</article>
