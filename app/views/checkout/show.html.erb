<% currency = @billing_selection.fetch(:currency) %>
<% plan_checkout = @checkout_kind == :plan %>
<% show_overage_pricing = !plan_checkout && @plan_quota_exhausted %>
<% selected_payment_method = @selected_payment_method %>
<% selected_outcome = @simulate_outcome %>
<% sinpe_savings = @sinpe_savings_amount %>

<div class="paywall-layout checkout-page" data-testid="checkout-page" data-billing-currency="<%= currency %>">
  <article class="paywall-layout__main panel panel--chrome">
    <p class="checkout-demo-badge" data-testid="checkout-demo" role="status">
      <%= t("billing.checkout.demo_badge") %>
    </p>

    <h1 class="billing-page__title"><%= plan_checkout ? t("billing.checkout.title_plan") : t("billing.checkout.title") %></h1>

    <h2 class="checkout-section-title checkout-section-title--method" data-testid="checkout-method-title">
      <%= t("billing.checkout.choose_payment_method") %>
    </h2>

    <section class="checkout-method-selector panel panel--inset" data-testid="checkout-method-selector">
      <%= form_with url: checkout_path,
                    method: :get,
                    data: { turbo: false },
                    class: "checkout-method-selector__form" do %>
        <%= hidden_field_tag :nesting_run_id, @nesting_run&.id if params[:nesting_run_id].present? %>
        <%= hidden_field_tag :outcome, selected_outcome %>

        <div class="checkout-method-selector__options">
          <% if currency == :crc && @available_payment_methods.include?(:sinpe) %>
            <label class="checkout-method-selector__option">
              <input type="radio"
                     name="payment_method"
                     value="sinpe_crc"
                     <%= "checked" if selected_payment_method == "sinpe_crc" %>
                     data-action="change->this.form.requestSubmit">
              <span class="checkout-method-selector__label">
                <span class="checkout-method-selector__name"><%= t("billing.checkout.sinpe_crc") %></span>
                <% if sinpe_savings.present? %>
                  <span class="checkout-method-selector__badge" data-testid="checkout-sinpe-savings">
                    <%= t("billing.checkout.savings_badge", amount: format_billing_crc(sinpe_savings)) %>
                  </span>
                <% end %>
              </span>
            </label>
          <% end %>

          <% if currency == :crc %>
            <label class="checkout-method-selector__option">
              <input type="radio"
                     name="payment_method"
                     value="card_crc"
                     <%= "checked" if selected_payment_method == "card_crc" %>
                     data-action="change->this.form.requestSubmit">
              <span class="checkout-method-selector__label"><%= t("billing.paywall.card_crc") %></span>
            </label>
          <% else %>
            <label class="checkout-method-selector__option">
              <input type="radio"
                     name="payment_method"
                     value="card_usd"
                     <%= "checked" if selected_payment_method == "card_usd" %>
                     data-action="change->this.form.requestSubmit">
              <span class="checkout-method-selector__label"><%= t("billing.checkout.card_usd") %></span>
            </label>
          <% end %>
        </div>
      <% end %>
    </section>

    <div class="checkout-pricing panel panel--inset" data-testid="checkout-pricing-block">
      <dl class="checkout-pricing__list">
        <div class="checkout-pricing__row" data-testid="checkout-pricing">
          <dt>
            <% if plan_checkout %>
              <%= plan_tier_label(@tier_months) %>
            <% else %>
              <%= t("billing.checkout.single_download") %>
            <% end %>
          </dt>
          <dd>
            <% if plan_checkout %>
              <% if currency == :crc %>
                <%= format_billing_crc(@checkout_breakdown.fetch(:list_price)) %>
              <% else %>
                <%= format_billing_usd(@checkout_breakdown.fetch(:list_price)) %>
              <% end %>
            <% elsif currency == :crc %>
              <%= format_billing_crc(Billing::Pricing.single_download_sinpe_crc) %>
              <span class="checkout-pricing__muted">/ <%= format_billing_crc(Billing::Pricing.single_download_official_crc) %></span>
            <% else %>
              <%= format_billing_usd(Billing::Pricing.single_download_official_usd) %>
            <% end %>
          </dd>
        </div>
        <% if show_overage_pricing %>
          <div class="checkout-pricing__row checkout-pricing__row--muted" data-testid="checkout-overage-pricing">
            <dt><%= t("billing.checkout.overage_hint") %></dt>
            <dd>
              <% if currency == :crc %>
                <%= format_billing_crc(Billing::Pricing.single_download_overage_sinpe_crc) %>
                <span class="checkout-pricing__muted">/ <%= format_billing_crc(Billing::Pricing.single_download_overage_official_crc) %></span>
              <% else %>
                <%= format_billing_usd(Billing::Pricing.single_download_overage_usd) %>
              <% end %>
            </dd>
          </div>
        <% end %>
      </dl>
    </div>

    <% unless plan_checkout %>
      <p class="checkout-page__intro"><%= t("billing.single_download.retention_24h") %></p>
    <% end %>

    <%# Detail depends on chosen payment method (SINPE promo vs official card). %>
    <% if @checkout_breakdown %>
      <h2 class="checkout-section-title" data-testid="checkout-detail-title"><%= t("billing.checkout.detail_title") %></h2>
      <section class="checkout-breakdown panel panel--inset" data-testid="checkout-breakdown">
        <%= render "shared/billing_breakdown", breakdown: @checkout_breakdown %>
      </section>
    <% end %>

    <%= form_with url: checkout_simulate_path,
                  method: :post,
                  data: { turbo: false },
                  class: "checkout-process-form" do %>
      <%= hidden_field_tag :nesting_run_id, @nesting_run&.id if @nesting_run.present? %>
      <%= hidden_field_tag :tier_months, @tier_months if plan_checkout %>
      <%= hidden_field_tag :payment_method, selected_payment_method %>
      <%= hidden_field_tag :outcome, selected_outcome %>

      <footer class="checkout-footer paywall-actions">
        <%= button_tag t("billing.checkout.process_payment"),
                       type: "submit",
                       class: "btn btn-primary",
                       data: { testid: "checkout-process-payment" } %>
        <% unless plan_checkout %>
          <%= link_to t("billing.checkout.download_now"),
                      nested_dxf_project_path(@project),
                      class: "btn btn-secondary",
                      data: { testid: "checkout-download-now", turbo: false } %>
        <% end %>
        <%= link_to t("billing.checkout.back_to_paywall"),
                    download_paywall_workshop_path,
                    class: "btn btn-secondary",
                    data: { testid: "checkout-back-to-paywall", turbo: false } %>
        <%= link_to t("billing.paywall.back_to_project"),
                    project_path(@project),
                    class: "btn btn-secondary",
                    data: { testid: "checkout-back-to-project", turbo: false } %>
      </footer>
    <% end %>
  </article>

  <aside class="paywall-layout__aside panel panel--inset" aria-labelledby="checkout-aside-title">
    <%= image_tag "/images/logo.png", alt: t("application.name"), class: "paywall-aside__logo" %>
    <h2 id="checkout-aside-title" class="paywall-aside__title"><%= t("billing.paywall.aside.title") %></h2>
    <p class="paywall-aside__lead"><%= t("billing.paywall.aside.lead") %></p>
    <ul class="paywall-aside__benefits">
      <li>
        <%= t("billing.paywall.aside.benefit_ready") %>
        <ul class="paywall-aside__benefits-nested">
          <li><%= t("billing.paywall.aside.benefit_retention") %></li>
        </ul>
      </li>
      <li><%= t("billing.paywall.aside.benefit_plan") %></li>
    </ul>
  </aside>
</div>
