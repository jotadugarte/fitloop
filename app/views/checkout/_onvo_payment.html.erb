<%# locals: (selected_payment_method:, nesting_run:, tier_months:, plan_checkout:) %>
<div class="checkout-onvo panel panel--inset"
     data-controller="onvo-checkout"
     data-onvo-checkout-pay-url-value="<%= checkout_pay_path %>"
     data-onvo-checkout-payment-method-value="<%= selected_payment_method %>"
     data-onvo-checkout-processing-url-value="<%= checkout_processing_path(":payment_id") %>"
     data-onvo-checkout-sinpe-url-value="<%= checkout_confirm_sinpe_path(":payment_id") %>"
     data-onvo-checkout-card-url-value="<%= checkout_confirm_card_path(":payment_id") %>"
     data-sinpe-instructions-template="<%= t("billing.checkout.onvo.sinpe_instructions_body") %>"
     data-testid="checkout-onvo-shell">

  <div data-onvo-checkout-target="cardPanel"
       class="checkout-onvo__panel"
       data-testid="onvo-card-panel"
       <%= "hidden" if selected_payment_method.start_with?("sinpe") %>>
    <p class="checkout-onvo__lead"><%= t("billing.checkout.onvo.fraud_monitoring_note") %></p>

    <div class="checkout-onvo__card-fields panel panel--inset" data-testid="onvo-card-fields">
      <h3 class="checkout-section-title"><%= t("billing.checkout.onvo.card_fields_title") %></h3>
      <div class="checkout-onvo__field field">
        <label for="card_holder_name"><%= t("billing.checkout.onvo.card_holder_name") %></label>
        <input type="text"
               id="card_holder_name"
               name="card_holder_name"
               class="checkout-onvo__input"
               autocomplete="cc-name"
               value="<%= current_user.name %>"
               data-onvo-checkout-target="cardHolderName"
               required>
      </div>
      <div class="checkout-onvo__field field">
        <label for="card_number"><%= t("billing.checkout.onvo.card_number") %></label>
        <input type="text"
               id="card_number"
               name="card_number"
               class="checkout-onvo__input"
               autocomplete="cc-number"
               inputmode="numeric"
               data-onvo-checkout-target="cardNumber"
               required>
      </div>
      <div class="checkout-onvo__field-row">
        <div class="checkout-onvo__field field">
          <label for="card_exp"><%= t("billing.checkout.onvo.card_exp") %></label>
          <input type="text"
                 id="card_exp"
                 name="card_exp"
                 class="checkout-onvo__input"
                 autocomplete="cc-exp"
                 placeholder="<%= t("billing.checkout.onvo.card_exp_placeholder") %>"
                 data-onvo-checkout-target="cardExp"
                 required>
        </div>
        <div class="checkout-onvo__field field">
          <label for="card_cvv"><%= t("billing.checkout.onvo.card_cvv") %></label>
          <input type="text"
                 id="card_cvv"
                 name="card_cvv"
                 class="checkout-onvo__input"
                 autocomplete="cc-csc"
                 inputmode="numeric"
                 maxlength="4"
                 data-onvo-checkout-target="cardCvv"
                 required>
        </div>
      </div>
    </div>
  </div>

  <div data-onvo-checkout-target="sinpePanel"
       class="checkout-onvo__panel"
       data-testid="onvo-sinpe-panel"
       <%= "hidden" unless selected_payment_method.start_with?("sinpe") %>>
    <section class="checkout-onvo__sinpe-how panel panel--inset" data-testid="onvo-sinpe-how">
      <h3 class="checkout-section-title"><%= t("billing.checkout.onvo.sinpe_how_title") %></h3>
      <ol class="checkout-onvo__steps">
        <li><%= t("billing.checkout.onvo.sinpe_how_step_1") %></li>
        <li><%= t("billing.checkout.onvo.sinpe_how_step_2") %></li>
        <li><%= t("billing.checkout.onvo.sinpe_how_step_3") %></li>
        <li><%= t("billing.checkout.onvo.sinpe_how_step_4") %></li>
      </ol>
    </section>

    <div class="checkout-onvo__sinpe-fields panel panel--inset" data-testid="onvo-sinpe-fields">
      <h3 class="checkout-section-title"><%= t("billing.checkout.onvo.sinpe_fields_title") %></h3>
      <div class="checkout-onvo__field field">
        <label for="sinpe_identification"><%= t("billing.checkout.onvo.sinpe_identification") %></label>
        <input type="text"
               id="sinpe_identification"
               name="sinpe_identification"
               class="checkout-onvo__input"
               autocomplete="off"
               data-onvo-checkout-target="sinpeIdentification"
               required>
      </div>
      <div class="checkout-onvo__field field">
        <label for="sinpe_mobile_number"><%= t("billing.checkout.onvo.sinpe_mobile_number") %></label>
        <input type="tel"
               id="sinpe_mobile_number"
               name="sinpe_mobile_number"
               class="checkout-onvo__input"
               autocomplete="tel"
               inputmode="tel"
               data-onvo-checkout-target="sinpeMobileNumber"
               required>
      </div>
    </div>

    <section class="checkout-onvo__sinpe-instructions panel panel--inset"
             data-onvo-checkout-target="sinpeInstructions"
             data-testid="onvo-sinpe-instructions"
             hidden>
      <h3 class="checkout-section-title"><%= t("billing.checkout.onvo.sinpe_instructions_title") %></h3>
      <p class="checkout-onvo__lead" data-onvo-checkout-target="sinpeInstructionsBody"></p>
    </section>
  </div>

  <p class="checkout-onvo__error"
     data-onvo-checkout-target="errorMessage"
     data-testid="onvo-checkout-error"
     hidden
     role="alert"></p>

  <footer class="checkout-footer paywall-actions checkout-onvo__footer">
    <%= hidden_field_tag :nesting_run_id, nesting_run&.id, data: { onvo_checkout_target: "nestingRunId" } %>
    <%= hidden_field_tag :tier_months, tier_months, data: { onvo_checkout_target: "tierMonths" } if plan_checkout %>
    <%= hidden_field_tag :payment_method, selected_payment_method, data: { onvo_checkout_target: "paymentMethodField" } %>

    <button type="button"
            class="btn btn-primary"
            data-testid="checkout-process-payment"
            data-action="click->onvo-checkout#processPayment"
            data-onvo-checkout-target="processButton">
      <%= t("billing.checkout.process_payment") %>
    </button>
    <%= link_to t("billing.checkout.back_to_paywall"),
                download_paywall_workshop_path,
                class: "btn btn-secondary",
                data: { testid: "checkout-back-to-paywall", turbo: false } %>
    <%= link_to t("billing.checkout.back_to_project"),
                project_path(@project),
                class: "btn btn-secondary",
                data: { testid: "checkout-back-to-project", turbo: false } %>
  </footer>
</div>
