<%# locals: (selected_payment_method:, nesting_run:, tier_months:, plan_checkout:, resume_sinpe_payment: nil) %>
<div class="checkout-onvo panel panel--inset"
     data-controller="onvo-checkout"
     data-onvo-checkout-pay-url-value="<%= checkout_pay_path %>"
     data-onvo-checkout-payment-method-value="<%= selected_payment_method %>"
     data-onvo-checkout-processing-url-value="<%= checkout_processing_path(":payment_id") %>"
     data-onvo-checkout-sinpe-url-value="<%= checkout_confirm_sinpe_path(":payment_id") %>"
     data-onvo-checkout-card-url-value="<%= checkout_confirm_card_path(":payment_id") %>"
     data-onvo-checkout-validation-messages-value="<%= {
       holder_name_invalid: t("billing.checkout.onvo.validation.holder_name_invalid"),
       card_number_invalid: t("billing.checkout.onvo.validation.card_number_invalid"),
       card_exp_invalid: t("billing.checkout.onvo.validation.card_exp_invalid"),
       card_exp_expired: t("billing.checkout.onvo.validation.card_exp_expired"),
       card_cvv_invalid: t("billing.checkout.onvo.validation.card_cvv_invalid"),
       card_number_test_only: t("billing.checkout.onvo.validation.card_number_test_only"),
       sinpe_identification_invalid: t("billing.checkout.onvo.validation.sinpe_identification_invalid"),
       sinpe_mobile_number_invalid: t("billing.checkout.onvo.validation.sinpe_mobile_number_invalid"),
       sinpe_mobile_number_test_only: t("billing.checkout.onvo.validation.sinpe_mobile_number_test_only")
     }.to_json %>"
     <% if ENV.fetch("ONVO_MODE", "test") == "test" %>
     data-onvo-checkout-test-cards-value="<%= Billing::Onvo::TestCardNumbers::NUMBERS.to_json %>"
     data-onvo-checkout-test-sinpe-mobile-numbers-value="<%= Billing::Onvo::TestSinpeMobileNumbers::LOCAL_NUMBERS.to_json %>"
     <% end %>
     <% if resume_sinpe_payment %>
     data-onvo-checkout-resume-payment-id-value="<%= resume_sinpe_payment.id %>"
     <% if resume_sinpe_payment.sinpe_awaiting_transfer? %>
     data-onvo-checkout-resume-sinpe-awaiting-transfer-value="true"
     data-onvo-checkout-resume-amount-label-value="<%= format_onvo_amount(resume_sinpe_payment.total_amount, resume_sinpe_payment.currency) %>"
     data-onvo-checkout-resume-destination-number-value="<%= Billing::Onvo::SinpeDestination.number %>"
     data-onvo-checkout-resume-destination-name-value="<%= Billing::Onvo::SinpeDestination.holder_name %>"
     data-onvo-checkout-resume-transfer-identification-value="<%= resume_sinpe_payment.sinpe_transfer_identification %>"
     data-onvo-checkout-resume-transfer-mobile-number-value="<%= resume_sinpe_payment.sinpe_transfer_mobile_number %>"
     <% end %>
     <% end %>
     data-onvo-checkout-process-payment-label-value="<%= t("billing.checkout.process_payment") %>"
     data-onvo-checkout-sinpe-continue-label-value="<%= t("billing.checkout.onvo.sinpe_continue") %>"
     data-testid="checkout-onvo-shell">

  <div data-onvo-checkout-target="cardPanel"
       class="checkout-onvo__panel"
       data-testid="onvo-card-panel"
       <%= "hidden" if selected_payment_method.start_with?("sinpe") %>>
    <p class="checkout-onvo__lead"><%= t("billing.checkout.onvo.fraud_monitoring_note") %></p>

    <div class="checkout-onvo__card-fields panel panel--inset" data-testid="onvo-card-fields">
      <h3 class="checkout-section-title"><%= t("billing.checkout.onvo.card_fields_title") %></h3>
      <div class="checkout-onvo__field field">
        <label for="card_holder_name"><%= t("billing.checkout.onvo.card_holder_name") %></label>
        <input type="text"
               id="card_holder_name"
               name="card_holder_name"
               class="checkout-onvo__input"
               autocomplete="cc-name"
               maxlength="100"
               minlength="2"
               value="<%= current_user.name %>"
               data-onvo-checkout-target="cardHolderName"
               data-action="input->onvo-checkout#formatHolderName"
               required>
      </div>
      <div class="checkout-onvo__field field">
        <label for="card_number"><%= t("billing.checkout.onvo.card_number") %></label>
        <input type="text"
               id="card_number"
               name="card_number"
               class="checkout-onvo__input"
               autocomplete="cc-number"
               inputmode="numeric"
               maxlength="19"
               pattern="[0-9]{13,19}"
               data-onvo-checkout-target="cardNumber"
               data-action="input->onvo-checkout#formatCardNumber"
               required>
      </div>
      <div class="checkout-onvo__field-row">
        <div class="checkout-onvo__field field">
          <label for="card_exp"><%= t("billing.checkout.onvo.card_exp") %></label>
          <input type="text"
                 id="card_exp"
                 name="card_exp"
                 class="checkout-onvo__input"
                 autocomplete="cc-exp"
                 inputmode="numeric"
                 maxlength="5"
                 placeholder="<%= t("billing.checkout.onvo.card_exp_placeholder") %>"
                 pattern="(0[1-9]|1[0-2])/[0-9]{2}"
                 data-onvo-checkout-target="cardExp"
                 data-action="input->onvo-checkout#formatCardExp"
                 required>
        </div>
        <div class="checkout-onvo__field field">
          <label for="card_cvv"><%= t("billing.checkout.onvo.card_cvv") %></label>
          <input type="text"
                 id="card_cvv"
                 name="card_cvv"
                 class="checkout-onvo__input"
                 autocomplete="cc-csc"
                 inputmode="numeric"
                 maxlength="4"
                 minlength="3"
                 pattern="[0-9]{3,4}"
                 data-onvo-checkout-target="cardCvv"
                 data-action="input->onvo-checkout#formatCardCvv"
                 required>
        </div>
      </div>
    </div>
  </div>

  <div data-onvo-checkout-target="sinpePanel"
       class="checkout-onvo__panel"
       data-testid="onvo-sinpe-panel"
       <%= "hidden" unless selected_payment_method.start_with?("sinpe") %>>
    <section class="checkout-onvo__sinpe-how panel panel--inset"
             data-onvo-checkout-target="sinpeHow"
             data-testid="onvo-sinpe-how">
      <h3 class="checkout-section-title"><%= t("billing.checkout.onvo.sinpe_how_title") %></h3>
      <ol class="checkout-onvo__steps">
        <li><%= t("billing.checkout.onvo.sinpe_how_step_1") %></li>
        <li><%= t("billing.checkout.onvo.sinpe_how_step_2") %></li>
        <li><%= t("billing.checkout.onvo.sinpe_how_step_3") %></li>
        <li><%= t("billing.checkout.onvo.sinpe_how_step_4") %></li>
      </ol>
    </section>

    <div class="checkout-onvo__sinpe-fields panel panel--inset"
         data-onvo-checkout-target="sinpeFields"
         data-testid="onvo-sinpe-fields">
      <h3 class="checkout-section-title"><%= t("billing.checkout.onvo.sinpe_fields_title") %></h3>
      <div class="checkout-onvo__field field">
        <label for="sinpe_identification"><%= t("billing.checkout.onvo.sinpe_identification") %></label>
        <input type="text"
               id="sinpe_identification"
               name="sinpe_identification"
               class="checkout-onvo__input"
               autocomplete="off"
               inputmode="numeric"
               maxlength="12"
               minlength="9"
               pattern="[0-9]{9,12}"
               data-onvo-checkout-target="sinpeIdentification"
               data-action="input->onvo-checkout#formatSinpeIdentification"
               required>
      </div>
      <div class="checkout-onvo__field field">
        <label for="sinpe_mobile_number"><%= t("billing.checkout.onvo.sinpe_mobile_number") %></label>
        <input type="tel"
               id="sinpe_mobile_number"
               name="sinpe_mobile_number"
               class="checkout-onvo__input"
               autocomplete="tel"
               inputmode="numeric"
               maxlength="8"
               minlength="8"
               pattern="[0-9]{8}"
               data-onvo-checkout-target="sinpeMobileNumber"
               data-action="input->onvo-checkout#formatSinpeMobileNumber"
               required>
      </div>
    </div>

    <section class="checkout-onvo__sinpe-instructions panel panel--inset"
             data-onvo-checkout-target="sinpeInstructions"
             data-testid="onvo-sinpe-instructions"
             hidden>
      <h3 class="checkout-section-title"><%= t("billing.checkout.onvo.sinpe_instructions_title") %></h3>

      <div class="checkout-onvo__sinpe-reference panel panel--inset">
        <p class="checkout-onvo__sinpe-reference-heading"><%= t("billing.checkout.onvo.sinpe_transferor_reference_heading") %></p>
        <p class="checkout-onvo__sinpe-reference-hint"><%= t("billing.checkout.onvo.sinpe_transferor_reference_hint") %></p>
        <div class="checkout-onvo__sinpe-reference-grid">
          <div class="checkout-onvo__sinpe-reference-item">
            <span class="checkout-onvo__sinpe-reference-label"><%= t("billing.checkout.onvo.sinpe_identification") %></span>
            <span class="checkout-onvo__sinpe-reference-value"
                  data-onvo-checkout-target="sinpeInstructionIdentification"
                  data-testid="sinpe-instruction-identification"></span>
          </div>
          <div class="checkout-onvo__sinpe-reference-item">
            <span class="checkout-onvo__sinpe-reference-label"><%= t("billing.checkout.onvo.sinpe_mobile_number") %></span>
            <span class="checkout-onvo__sinpe-reference-value"
                  data-onvo-checkout-target="sinpeInstructionMobileNumber"
                  data-testid="sinpe-instruction-mobile"></span>
          </div>
        </div>
      </div>

      <p class="checkout-onvo__sinpe-destination-heading"><%= t("billing.checkout.onvo.sinpe_destination_reference_heading") %></p>
      <dl class="checkout-onvo__sinpe-transfer-details">
        <div class="checkout-onvo__sinpe-transfer-row">
          <dt><%= t("billing.checkout.onvo.sinpe_destination_amount") %></dt>
          <dd data-onvo-checkout-target="sinpeInstructionAmount"></dd>
        </div>
        <div class="checkout-onvo__sinpe-transfer-row">
          <dt><%= t("billing.checkout.onvo.sinpe_destination_number") %></dt>
          <dd data-onvo-checkout-target="sinpeInstructionNumber"></dd>
        </div>
        <div class="checkout-onvo__sinpe-transfer-row">
          <dt><%= t("billing.checkout.onvo.sinpe_destination_name") %></dt>
          <dd data-onvo-checkout-target="sinpeInstructionName"></dd>
        </div>
      </dl>
      <p class="checkout-onvo__lead"><%= t("billing.checkout.onvo.sinpe_instructions_note") %></p>
    </section>
  </div>

  <p class="checkout-onvo__error"
     data-onvo-checkout-target="errorMessage"
     data-testid="onvo-checkout-error"
     hidden
     role="alert"></p>

  <footer class="checkout-footer paywall-actions checkout-onvo__footer">
    <%= hidden_field_tag :nesting_run_id, nesting_run&.id, data: { onvo_checkout_target: "nestingRunId" } %>
    <%= hidden_field_tag :tier_months, tier_months, data: { onvo_checkout_target: "tierMonths" } if plan_checkout %>
    <%= hidden_field_tag :payment_method, selected_payment_method, data: { onvo_checkout_target: "paymentMethodField" } %>

    <button type="button"
            class="btn btn-primary checkout-onvo__primary-action"
            data-testid="checkout-process-payment"
            data-action="click->onvo-checkout#processPayment"
            data-onvo-checkout-target="processButton">
      <%= t("billing.checkout.process_payment") %>
    </button>
    <div class="checkout-onvo__secondary-actions"
         data-onvo-checkout-target="secondaryActions">
      <%= link_to t("billing.checkout.back_to_paywall"),
                  download_paywall_workshop_path,
                  class: "btn btn-secondary",
                  data: { testid: "checkout-back-to-paywall", turbo: false } %>
      <%= link_to t("billing.checkout.back_to_project"),
                  project_path(@project),
                  class: "btn btn-secondary",
                  data: { testid: "checkout-back-to-project", turbo: false } %>
    </div>
  </footer>
</div>
