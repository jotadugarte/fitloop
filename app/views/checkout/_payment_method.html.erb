<section class="checkout-method panel panel--inset" data-testid="<%= testid %>">
  <h2 class="checkout-method__title"><%= title %></h2>
  <%= form_with url: checkout_simulate_path, method: :post, data: { turbo: false }, class: "checkout-method__form" do %>
    <%= hidden_field_tag :nesting_run_id, nesting_run_id %>
    <%= hidden_field_tag :payment_method, payment_method %>
    <div class="checkout-simulate-actions">
      <%= button_tag t("billing.checkout.simulate_success"),
                     name: "outcome",
                     value: "success",
                     class: "btn btn-primary",
                     data: { testid: "checkout-simulate-success" } %>
      <%= button_tag t("billing.checkout.simulate_failure"),
                     name: "outcome",
                     value: "failure",
                     class: "btn btn-secondary",
                     data: { testid: "checkout-simulate-failure" } %>
    </div>
  <% end %>
</section>
