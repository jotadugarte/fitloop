<div class="paywall-layout"
     data-testid="download-paywall"
     data-billing-currency="<%= @billing_selection.fetch(:currency) %>"
     data-billing-payment-method="<%= @billing_selection.fetch(:payment_method) %>">
  <article class="paywall-layout__main panel panel--chrome">
    <h1><%= t("billing.paywall.title") %></h1>
    <p><%= t("billing.paywall.intro") %></p>
    <p><%= t("billing.single_download.retention_24h") %></p>

    <%= form_with url: workspace_workshop_path, method: :patch, data: { turbo: false } do %>
      <%= hidden_field_tag :section, "billing" %>
      <div class="field">
        <label for="billing_currency">Currency</label>
        <select id="billing_currency" name="billing[currency]">
          <option value="crc" <%= "selected" if @billing_selection.fetch(:currency) == :crc %>>CRC</option>
          <option value="usd" <%= "selected" if @billing_selection.fetch(:currency) == :usd %>>USD</option>
        </select>
      </div>
      <div class="field">
        <label for="billing_payment_method">Payment method</label>
        <select id="billing_payment_method" name="billing[payment_method]">
          <% if @available_payment_methods.include?(:sinpe) %>
            <option value="sinpe" <%= "selected" if @billing_selection.fetch(:payment_method) == :sinpe %>>SINPE</option>
          <% end %>
          <option value="card" <%= "selected" if @billing_selection.fetch(:payment_method) == :card %>>Card</option>
        </select>
      </div>
      <%= button_tag "Apply", class: "btn btn-secondary" %>
    <% end %>

    <% if @plan_download_included %>
      <p class="paywall-plan-quota" data-testid="paywall-plan-quota-hint">
        <%= t("billing.paywall.plan_quota_available") %>
      </p>
    <% end %>

    <ul class="paywall-options">
      <% if @nesting_run && @single_download_checkout_allowed %>
        <li>
          <%= link_to t("billing.paywall.pay_this_download"),
                      checkout_path(nesting_run_id: @nesting_run.id),
                      class: "btn btn-primary",
                      data: { testid: "paywall-checkout", turbo: false } %>
        </li>
      <% elsif @nesting_run && @plan_download_included %>
        <li>
          <%= link_to t("billing.paywall.download_with_plan"),
                      nested_dxf_project_path(@project),
                      class: "btn btn-primary",
                      data: { testid: "paywall-plan-download", turbo: false } %>
        </li>
      <% end %>
      <li>
        <%= link_to t("billing.paywall.view_plans"),
                    planes_path(project_id: @project.id),
                    class: "btn btn-secondary",
                    data: { testid: "paywall-planes", turbo: false } %>
      </li>
    </ul>

    <div class="paywall-inline-plans" data-testid="paywall-inline-plans">
      <% [[1, "tier_1"], [2, "tier_2"], [4, "tier_4"]].each do |months, label_key| %>
        <section class="paywall-plan-tier panel panel--inset" data-testid="paywall-plan-tier-<%= months %>">
          <h3 class="paywall-plan-tier__title"><%= t("billing.planes.#{label_key}") %></h3>

          <%= form_with url: carrito_path, method: :post, data: { turbo: false } do %>
            <%= hidden_field_tag :kind, "plan" %>
            <%= hidden_field_tag :tier_months, months %>
            <%= hidden_field_tag :currency_mode, @billing_selection.fetch(:currency).to_s %>
            <%= button_tag t("billing.cart.add_to_cart", default: "Añadir al carrito"),
                           class: "btn btn-primary",
                           data: { testid: "paywall-add-plan-#{months}" } %>
          <% end %>
        </section>
      <% end %>
    </div>

    <div class="paywall-actions">
      <%= link_to t("billing.paywall.back_to_project"),
                  project_path(@project),
                  class: "btn btn-secondary",
                  data: { testid: "paywall-back-to-project", turbo: false } %>
    </div>
  </article>

  <aside class="paywall-layout__aside panel panel--inset" aria-labelledby="paywall-aside-title">
    <%= image_tag "/images/logo.png", alt: t("application.name"), class: "paywall-aside__logo" %>
    <h2 id="paywall-aside-title" class="paywall-aside__title"><%= t("billing.paywall.aside.title") %></h2>
    <p class="paywall-aside__lead"><%= t("billing.paywall.aside.lead") %></p>
    <ul class="paywall-aside__benefits">
      <li>
        <%= t("billing.paywall.aside.benefit_ready") %>
        <ul class="paywall-aside__benefits-nested">
          <li><%= t("billing.paywall.aside.benefit_retention") %></li>
        </ul>
      </li>
      <li><%= t("billing.paywall.aside.benefit_plan") %></li>
    </ul>
  </aside>
</div>
