<div class="paywall-layout planes-page" data-controller="timezone-capture" data-testid="planes-checkout">
  <%= hidden_field_tag :time_zone, current_user&.time_zone, data: { timezone_capture_target: "timeZone" } %>

  <article class="paywall-layout__main panel panel--chrome">
    <p class="checkout-demo-badge" data-testid="checkout-demo" role="status">
      <%= t("billing.checkout.demo_badge") %>
    </p>

    <h1 class="billing-page__title"><%= t("billing.planes.title") %></h1>

    <% unless @project %>
      <p class="checkout-page__intro"><%= t("billing.planes.browse_intro") %></p>
    <% end %>

    <div class="planes-tiers">
      <% [[1, "tier_1", Billing::Pricing.plan_1_month_card_usd, Billing::Pricing.plan_1_month_sinpe_crc],
         [2, "tier_2", Billing::Pricing.plan_2_months_card_usd, Billing::Pricing.plan_2_months_sinpe_crc],
         [4, "tier_4", Billing::Pricing.plan_4_months_card_usd, Billing::Pricing.plan_4_months_sinpe_crc]].each do |months, label_key, usd, crc| %>
        <section class="planes-tier panel panel--inset" data-testid="planes-tier-<%= months %>">
          <h2 class="planes-tier__title"><%= t("billing.planes.#{label_key}") %></h2>

          <dl class="checkout-pricing__list planes-tier__pricing">
            <div class="checkout-pricing__row">
              <dt><%= t("billing.checkout.card_usd") %></dt>
              <dd>USD <%= usd %></dd>
            </div>
            <div class="checkout-pricing__row checkout-pricing__row--muted">
              <dt><%= t("billing.checkout.sinpe_crc") %></dt>
              <dd>CRC <%= crc %></dd>
            </div>
          </dl>

          <% if @project %>
            <div class="planes-tier__payments">
              <%= render "planes/plan_payment",
                         testid: "checkout-pay-card-usd",
                         title: t("billing.checkout.card_usd"),
                         project_id: @project.id,
                         tier_months: months,
                         payment_method: "card_usd" %>
              <%= render "planes/plan_payment",
                         testid: "checkout-pay-sinpe-crc",
                         title: t("billing.checkout.sinpe_crc"),
                         project_id: @project.id,
                         tier_months: months,
                         payment_method: "sinpe_crc" %>
            </div>
          <% end %>
        </section>
      <% end %>
    </div>

    <footer class="checkout-footer paywall-actions">
      <% if @project %>
        <%= link_to t("billing.paywall.back_to_project"),
                    project_path(@project),
                    class: "btn btn-secondary",
                    data: { testid: "planes-back-to-project", turbo: false } %>
      <% end %>
      <%= link_to t("auth.nav.payments"), mis_pagos_path, class: "btn btn-secondary", data: { turbo_frame: "_top" } %>
    </footer>
  </article>

  <aside class="paywall-layout__aside panel panel--inset" aria-labelledby="planes-aside-title">
    <%= image_tag "/images/logo.png", alt: t("application.name"), class: "paywall-aside__logo" %>
    <h2 id="planes-aside-title" class="paywall-aside__title"><%= t("billing.paywall.aside.title") %></h2>
    <p class="paywall-aside__lead"><%= t("billing.planes.aside.lead") %></p>
    <ul class="paywall-aside__benefits">
      <li><%= t("billing.paywall.aside.benefit_plan") %></li>
      <li><%= t("billing.paywall.aside.benefit_retention") %></li>
    </ul>
  </aside>
</div>
