<% currency = @billing_selection&.fetch(:currency) %>

<div class="checkout-page cart-page" data-testid="cart-page" data-billing-currency="<%= currency %>">
  <h1 class="billing-page__title"><%= t("billing.cart.title") %></h1>

  <% if @cart.blank? %>
    <p class="cart-page__empty" data-testid="cart-empty"><%= t("billing.cart.empty", default: "Tu carrito está vacío.") %></p>
  <% else %>
    <p class="checkout-region-currency" data-testid="cart-region-currency">
      <%= t("billing.checkout.region_currency", currency: billing_currency_label(currency)) %>
    </p>

    <% if @checkout_breakdown %>
      <section class="checkout-breakdown panel panel--inset" data-testid="cart-breakdown">
        <h2><%= t("billing.checkout.breakdown.title") %></h2>
        <%= render "shared/billing_breakdown", breakdown: @checkout_breakdown %>
      </section>

      <%= link_to t("billing.cart.checkout", default: "Ir al checkout"),
                  checkout_path,
                  class: "btn btn-primary",
                  data: { testid: "cart-checkout", turbo: false } %>
    <% end %>
  <% end %>
</div>
