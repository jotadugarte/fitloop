<% primary_locales = %i[en es] %>
<% panic_locale = :es_panic %>
<% panic_available = I18n.available_locales.include?(panic_locale) %>

<nav class="locale-switcher" data-controller="locale-switcher" aria-label="<%= t("locale.switcher_label") %>">
  <div class="locale-switcher__group" role="group" aria-label="<%= t("locale.switcher_row_primary") %>">
    <% primary_locales.each do |locale| %>
      <% active = I18n.locale == locale %>
      <% btn_class = "btn btn--compact #{active ? 'btn-primary' : 'btn-secondary'}" %>
      <%= button_to t("locale.labels.#{locale}"),
            locale_path(locale: locale),
            method: :patch,
            class: btn_class,
            aria: { current: (active ? "true" : "false") },
            form: {
              class: "locale-switcher__form",
              data: { action: "submit->locale-switcher#attachSheetInventory" }
            } %>
    <% end %>
  </div>

  <% if panic_available %>
    <% active = I18n.locale == panic_locale %>
    <% panic_class = "btn btn--compact locale-switcher__btn--panic #{active ? 'btn-primary' : 'btn-secondary'}" %>
    <%= button_to t("locale.labels.es_panic"),
          locale_path(locale: panic_locale),
          method: :patch,
          class: panic_class,
          aria: { current: (active ? "true" : "false"), label: t("locale.labels.es_panic") },
          form: {
            class: "locale-switcher__form",
            data: { action: "submit->locale-switcher#attachSheetInventory" }
          } %>
  <% end %>
</nav>
