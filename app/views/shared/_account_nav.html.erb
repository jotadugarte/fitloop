<nav class="account-nav" data-testid="account-nav" aria-label="<%= t("auth.nav.label") %>">
  <% if user_signed_in? %>
    <%= link_to t("auth.nav.account"), edit_user_registration_path, class: "btn btn-secondary btn--compact", data: { turbo_frame: "_top" } %>
    <%= link_to t("auth.nav.payments"), mis_pagos_path, class: "btn btn-secondary btn--compact", data: { turbo_frame: "_top" } %>
    <% if current_user.admin? %>
      <%= link_to "Admin", admin_root_path, class: "btn btn-secondary btn--compact", data: { turbo_frame: "_top" } %>
    <% end %>
    <%= button_to t("auth.nav.sign_out"),
          destroy_user_session_path,
          method: :delete,
          class: "btn btn-secondary btn--compact",
          form: { data: { turbo: false } } %>
  <% else %>
    <%= link_to t("auth.nav.sign_in"), new_user_session_path, class: "btn btn-secondary btn--compact", data: { turbo_frame: "_top" } %>
    <%= link_to t("auth.nav.sign_up"), new_user_registration_path, class: "btn btn-primary btn--compact", data: { turbo_frame: "_top" } %>
  <% end %>
</nav>
