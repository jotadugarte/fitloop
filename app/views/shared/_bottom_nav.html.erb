<nav class="bottom-nav" aria-label="<%= t("nav.mobile") %>">
  <%= link_to root_path, class: "bottom-nav__item#{' bottom-nav__item--active' if fitloop_nav_active?(root_path)}", aria: { label: t("nav.home") } do %>
    <span class="bottom-nav__icon" aria-hidden="true">⌂</span>
    <span class="bottom-nav__label"><%= t("nav.home") %></span>
  <% end %>

  <% if defined?(@project) && @project&.persisted? %>
    <%= link_to @project, class: "bottom-nav__item#{' bottom-nav__item--active' if fitloop_nav_active?(@project)}", aria: { label: t("projects.show.session_title") } do %>
      <span class="bottom-nav__icon" aria-hidden="true">◫</span>
      <span class="bottom-nav__label"><%= truncate(t("projects.show.session_title"), length: 12) %></span>
    <% end %>
  <% end %>
</nav>
