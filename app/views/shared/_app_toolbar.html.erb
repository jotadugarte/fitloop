<header class="app-main__toolbar">
  <div class="app-toolbar" data-testid="app-toolbar">
    <div class="app-toolbar__start">
      <%= link_to root_path, class: "app-toolbar__home-link", title: t("nav.home"), data: { turbo: false, testid: "toolbar-home" } do %>
        <%= image_tag "/images/icono-modusloop.png", alt: "Home", class: "app-toolbar__home-icon" %>
      <% end %>
      <%= render "shared/locale_switcher" %>
    </div>

    <div class="app-toolbar__end" data-testid="app-toolbar-actions">
      <% unless current_page?(root_path) %>
        <%= link_to t("auth.nav.workshop"),
                    toolbar_workshop_path,
                    class: toolbar_workshop_button_class,
                    data: { testid: "toolbar-workshop", turbo_frame: "_top" } %>
      <% end %>
      <%= render "shared/account_nav" %>
    </div>
  </div>
</header>
