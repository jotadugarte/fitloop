<% flash.each do |type, message| %>
  <% next if message.blank? %>

  <div class="flash flash-<%= type %>" data-testid="flash-<%= type %>" role="<%= type.to_sym == :alert ? 'alert' : 'status' %>">
    <p class="flash__title"><%= t("application.dialog_title") %></p>
    <p class="flash__message"><%= message %></p>
  </div>
<% end %>
