<%# locals: (breakdown:) %>
<dl class="checkout-breakdown__list">
  <div class="checkout-breakdown__row">
    <dt><%= t("billing.checkout.breakdown.subtotal") %></dt>
    <dd data-testid="breakdown-list-price"><%= format_billing_amount(breakdown.fetch(:list_price), breakdown.fetch(:currency)) %></dd>
  </div>
  <% if breakdown.fetch(:discount_amount).positive? %>
    <div class="checkout-breakdown__row checkout-breakdown__row--discount">
      <dt><%= t("billing.checkout.breakdown.sinpe_discount") %></dt>
      <dd data-testid="breakdown-sinpe-discount">−<%= format_billing_amount(breakdown.fetch(:discount_amount), breakdown.fetch(:currency)) %></dd>
    </div>
  <% end %>
  <% if breakdown.fetch(:iva_applicable) %>
    <div class="checkout-breakdown__row" data-testid="checkout-iva">
      <dt><%= t("billing.checkout.breakdown.tax") %></dt>
      <dd data-testid="breakdown-tax"><%= format_billing_amount(breakdown.fetch(:tax_amount), breakdown.fetch(:currency)) %></dd>
    </div>
  <% end %>
  <div class="checkout-breakdown__row checkout-breakdown__row--total">
    <dt><%= t("billing.checkout.breakdown.total") %></dt>
    <dd data-testid="breakdown-total"><%= format_billing_amount(breakdown.fetch(:total_amount), breakdown.fetch(:currency)) %></dd>
  </div>
</dl>
