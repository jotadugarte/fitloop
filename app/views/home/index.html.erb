<main class="page page--landing fitloop-home" data-testid="fitloop-home">
  <section class="landing-hero">
    <%= image_tag "/images/logo.png", alt: t("application.name"), class: "landing-hero__logo" %>
    <p class="landing-hero__tagline"><%= t(".tagline") %></p>
    <p class="landing-hero__subtitle"><%= t(".subtitle") %></p>
    <div class="landing-hero__actions">
      <%= link_to t("home.index.cta_start"), start_project_path, class: "btn btn-primary" %>
    </div>
  </section>
</main>
