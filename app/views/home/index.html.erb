<main class="page page--landing fitloop-home" data-testid="fitloop-home">
  <section class="landing-hero">
    <%= image_tag "/images/logo.png", alt: "Fitloop", class: "landing-hero__logo" %>
    <h1 class="landing-hero__title">Fitloop</h1>
    <p class="landing-hero__tagline"><%= t(".tagline") %></p>
    <p class="landing-hero__subtitle"><%= t(".subtitle") %></p>
    <div class="landing-hero__actions">
      <%= link_to t("home.index.cta_new"), new_project_path, class: "btn btn-primary" %>
      <%= link_to t("projects.index.title"), projects_path, class: "btn btn-secondary" %>
    </div>
  </section>
</main>
