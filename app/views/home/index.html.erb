<main class="page page--landing tool-hub" data-testid="tool-hub">
  <header class="tool-hub__header">
    <%= image_tag "/images/logo-modusloop.png", alt: t("application.name"), class: "tool-hub__brand-logo" %>
    <h1 class="tool-hub__title"><%= t("home.hub.title") %></h1>
  </header>

  <div class="tool-hub__grid">
    <div class="tool-card tool-card--active" data-testid="tool-card-fitloop">
      <div class="tool-card__logo-container">
        <%= image_tag "/images/fitloop-logo.png", alt: "fiTLoop (Fitloop)", class: "tool-card__logo" %>
      </div>
      <p class="tool-card__tagline"><%= t("home.hub.fitloop_tagline") %></p>
      <%= link_to t("home.hub.open_tool"), workshop_path, class: "btn btn-primary tool-card__btn" %>
    </div>

    <div class="tool-card tool-card--disabled" data-testid="tool-card-syncloop" aria-disabled="true">
      <div class="tool-card__logo-container">
        <%= image_tag "/images/logo-syncloop.png", alt: "synCLoop", class: "tool-card__logo" %>
      </div>
      <p class="tool-card__tagline"><%= t("home.hub.syncloop_tagline") %></p>
      <span class="tool-card__badge"><%= t("home.hub.coming_soon") %></span>
    </div>

    <div class="tool-card tool-card--placeholder" data-testid="tool-card-placeholder">
      <div class="tool-card__placeholder-icon">+</div>
      <p class="tool-card__tagline"><%= t("home.hub.coming_soon") %></p>
    </div>
  </div>

  <footer class="tool-hub__footer" data-testid="tool-hub-footer">
    <nav class="tool-hub__footer-nav" aria-label="<%= t('feedback.footer.terms') %>">
      <%= link_to t("feedback.footer.terms"), terminos_path, class: "tool-hub__footer-link" %>
      <%= link_to t("feedback.footer.privacy"), privacidad_path, class: "tool-hub__footer-link" %>
      <%= link_to t("feedback.footer.discord"),
                  discord_invite_url,
                  target: "_blank",
                  rel: "noopener noreferrer",
                  class: "tool-hub__footer-link tool-hub__footer-link--discord",
                  data: { testid: "tool-hub-discord-link" } %>
    </nav>
  </footer>
</main>
