<div class="paywall-layout mis-pagos-page"
     data-testid="mis-pagos-page"
     <% if @pending_payment_status_url.present? %>
       data-controller="mis-pagos-pending-sync"
       data-mis-pagos-pending-sync-status-url-value="<%= @pending_payment_status_url %>"
       data-testid-mis-pagos-pending-sync="true"
     <% end %>>
  <% if @auto_download_grant %>
    <div class="mis-pagos-auto-download"
         data-controller="auto-download"
         data-auto-download-url-value="<%= mis_pagos_download_path(@auto_download_grant) %>"
         data-testid="mis-pagos-auto-download"
         aria-hidden="true"></div>
  <% end %>
  <article class="paywall-layout__main panel panel--chrome">
    <header class="mis-pagos-page__header">
      <h1 class="billing-page__title"><%= t("billing.mis_pagos.title") %></h1>
      <p class="mis-pagos-page__lead"><%= t("billing.mis_pagos.page_lead") %></p>
    </header>

    <%= render "projects/pending_payment_lock_banner",
               lock: @pending_checkout_lock,
               show_processing_link: false %>

    <section class="mis-pagos-zone mis-pagos-zone--plan panel panel--inset<%= " mis-pagos-zone--plan-active" if @subscription %>">
      <% if @subscription %>
        <%= render "mis_pagos/active_plan", subscription: @subscription, quota_counter: @quota_counter %>
      <% else %>
        <header class="mis-pagos-zone__header">
          <h2 class="mis-pagos-zone__title"><%= t("billing.mis_pagos.plan_section") %></h2>
        </header>
        <div class="mis-pagos-zone__empty mis-pagos-zone__empty--plan" data-testid="mis-pagos-no-plan">
          <p class="mis-pagos-zone__empty-text"><%= t("billing.mis_pagos.no_active_plan") %></p>
          <%= link_to t("billing.mis_pagos.aside.view_plans"),
                      download_paywall_workshop_path,
                      class: "btn btn-secondary btn--compact",
                      data: { turbo_frame: "_top" } %>
        </div>
      <% end %>
    </section>

    <section class="mis-pagos-zone panel panel--inset" data-testid="mis-pagos-single-purchases">
      <header class="mis-pagos-zone__header">
        <div class="mis-pagos-zone__heading">
          <h2 class="mis-pagos-zone__title"><%= t("billing.mis_pagos.downloads_heading") %></h2>
          <% if @downloads_ready_count.positive? || @downloads_pending_count.positive? %>
            <div class="mis-pagos-zone__summary">
              <% if @downloads_ready_count.positive? %>
                <span class="mis-pagos-zone__summary-chip mis-pagos-zone__summary-chip--ready">
                  <%= t("billing.mis_pagos.summary.available", count: @downloads_ready_count) %>
                </span>
              <% end %>
              <% if @downloads_pending_count.positive? %>
                <span class="mis-pagos-zone__summary-chip mis-pagos-zone__summary-chip--pending">
                  <%= t("billing.mis_pagos.summary.pending", count: @downloads_pending_count) %>
                </span>
              <% end %>
            </div>
          <% end %>
        </div>
        <p class="mis-pagos-zone__lead"><%= t("billing.mis_pagos.downloads_lead") %></p>
      </header>
      <% if @single_purchase_rows.any? %>
        <ul class="mis-pagos-download-list">
          <% @single_purchase_rows.each do |row| %>
            <%= render "mis_pagos/single_purchase_row", row: row %>
          <% end %>
        </ul>
      <% else %>
        <p class="mis-pagos-zone__empty-text"><%= t("billing.mis_pagos.no_single_purchases") %></p>
      <% end %>
    </section>

    <section class="mis-pagos-zone panel panel--inset" data-testid="mis-pagos-payments">
      <header class="mis-pagos-zone__header">
        <h2 class="mis-pagos-zone__title"><%= t("billing.mis_pagos.payment_history") %></h2>
        <p class="mis-pagos-zone__lead"><%= t("billing.mis_pagos.payments_lead") %></p>
      </header>
      <% if @payments.any? %>
        <div class="mis-pagos-payments-table">
          <div class="mis-pagos-payments-table__head" aria-hidden="true">
            <span><%= t("billing.mis_pagos.payments_table.date") %></span>
            <span><%= t("billing.mis_pagos.payments_table.type") %></span>
            <span><%= t("billing.mis_pagos.payments_table.status") %></span>
            <span><%= t("billing.mis_pagos.payments_table.amount") %></span>
          </div>
          <ul class="mis-pagos-payments-table__body">
            <% @payments.each do |payment| %>
              <%= render "mis_pagos/payment_row", payment: payment %>
            <% end %>
          </ul>
        </div>
      <% else %>
        <p class="mis-pagos-zone__empty-text"><%= t("billing.mis_pagos.no_payments") %></p>
      <% end %>
    </section>
  </article>

  <aside class="paywall-layout__aside panel panel--inset mis-pagos-page__aside" aria-labelledby="mis-pagos-aside-title">
    <%= image_tag "/images/logo.png", alt: t("application.name"), class: "paywall-aside__logo" %>
    <h2 id="mis-pagos-aside-title" class="paywall-aside__title"><%= t("billing.mis_pagos.aside.title") %></h2>
    <p class="paywall-aside__lead"><%= t("billing.mis_pagos.aside.lead") %></p>
    <ul class="paywall-aside__benefits">
      <li><%= t("billing.paywall.aside.benefit_retention") %></li>
      <li><%= t("billing.paywall.aside.benefit_plan") %></li>
    </ul>
    <p class="mis-pagos-aside__action">
      <%= link_to t("billing.mis_pagos.aside.view_plans"),
                  download_paywall_workshop_path,
                  class: "btn btn-secondary",
                  data: { turbo_frame: "_top" } %>
    </p>
  </aside>
</div>
