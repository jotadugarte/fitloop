<div class="paywall-layout mis-pagos-page"
     data-testid="mis-pagos-page"
     <% if @pending_payment_status_url.present? %>
       data-controller="mis-pagos-pending-sync"
       data-mis-pagos-pending-sync-status-url-value="<%= @pending_payment_status_url %>"
       data-testid-mis-pagos-pending-sync="true"
     <% end %>>
  <% if @auto_download_grant %>
    <div class="mis-pagos-auto-download"
         data-controller="auto-download"
         data-auto-download-url-value="<%= mis_pagos_download_path(@auto_download_grant) %>"
         data-testid="mis-pagos-auto-download"
         aria-hidden="true"></div>
  <% end %>
  <article class="paywall-layout__main panel panel--chrome">
    <h1 class="billing-page__title"><%= t("billing.mis_pagos.title") %></h1>

    <%= render "projects/pending_payment_lock_banner",
               lock: @pending_checkout_lock,
               show_processing_link: false %>

    <section class="mis-pagos-section panel panel--inset<%= " mis-pagos-section--active-plan" if @subscription %>">
      <% if @subscription %>
        <%= render "mis_pagos/active_plan", subscription: @subscription, quota_counter: @quota_counter %>
      <% else %>
        <p class="mis-pagos-section__empty" data-testid="mis-pagos-no-plan"><%= t("billing.mis_pagos.no_active_plan") %></p>
      <% end %>
    </section>

    <section class="mis-pagos-section panel panel--inset" data-testid="mis-pagos-single-purchases">
      <h2 class="mis-pagos-section__title"><%= t("billing.mis_pagos.single_purchases") %></h2>
      <% if @single_purchase_rows.any? %>
        <ul class="mis-pagos-list">
          <% @single_purchase_rows.each do |row| %>
            <%= render "mis_pagos/single_purchase_row", row: row %>
          <% end %>
        </ul>
      <% else %>
        <p class="mis-pagos-section__empty"><%= t("billing.mis_pagos.no_single_purchases") %></p>
      <% end %>
    </section>

    <section class="mis-pagos-section panel panel--inset" data-testid="mis-pagos-payments">
      <h2 class="mis-pagos-section__title"><%= t("billing.mis_pagos.payment_history") %></h2>
      <% if @payments.any? %>
        <ul class="mis-pagos-list">
          <% @payments.each do |payment| %>
            <li class="mis-pagos-list__item mis-pagos-list__item--payment" data-testid="mis-pagos-payment-row">
              <div class="mis-pagos-list__primary">
                <time class="mis-pagos-list__date" datetime="<%= payment.created_at.iso8601 %>">
                  <%= l_in_user_zone(payment.created_at, format: :short, user: current_user) %>
                </time>
                <span class="mis-pagos-list__purpose"><%= t("billing.mis_pagos.purpose.#{payment.purpose}") %></span>
              </div>
              <div class="mis-pagos-list__payment-meta">
                <span class="status-badge <%= payment_status_badge_class(payment.status) %>">
                  <%= t("billing.mis_pagos.status.#{payment.status}") %>
                </span>
                <span class="mis-pagos-list__amount"><%= payment.currency.upcase %> <%= payment.amount %></span>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="mis-pagos-section__empty"><%= t("billing.mis_pagos.no_payments") %></p>
      <% end %>
    </section>
  </article>

  <aside class="paywall-layout__aside panel panel--inset" aria-labelledby="mis-pagos-aside-title">
    <%= image_tag "/images/logo.png", alt: t("application.name"), class: "paywall-aside__logo" %>
    <h2 id="mis-pagos-aside-title" class="paywall-aside__title"><%= t("billing.mis_pagos.aside.title") %></h2>
    <p class="paywall-aside__lead"><%= t("billing.mis_pagos.aside.lead") %></p>
    <ul class="paywall-aside__benefits">
      <li><%= t("billing.paywall.aside.benefit_retention") %></li>
      <li><%= t("billing.paywall.aside.benefit_plan") %></li>
    </ul>
    <p class="mis-pagos-aside__action">
      <%= link_to t("billing.mis_pagos.aside.view_plans"),
                  download_paywall_workshop_path,
                  class: "btn btn-secondary",
                  data: { turbo_frame: "_top" } %>
    </p>
  </aside>
</div>
