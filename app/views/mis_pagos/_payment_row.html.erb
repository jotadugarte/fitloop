<%# locals: (payment:) %>
<li class="mis-pagos-payment-item" data-testid="mis-pagos-payment-row">
  <div class="mis-pagos-payment-item__top">
    <time class="mis-pagos-payment-item__date" datetime="<%= payment.created_at.iso8601 %>">
      <%= l_in_user_zone(payment.created_at, format: :short, user: current_user) %>
    </time>
    <span class="mis-pagos-payment-item__amount"><%= mis_pagos_payment_amount_label(payment) %></span>
  </div>
  <div class="mis-pagos-payment-item__bottom">
    <span class="mis-pagos-payment-item__purpose"><%= t("billing.mis_pagos.purpose.#{payment.purpose}") %></span>
    <span class="status-badge status-badge--compact <%= payment_status_badge_class(payment.status) %>">
      <%= t("billing.mis_pagos.status.#{payment.status}") %>
    </span>
  </div>
</li>
