<%# locals: (payments:) %>
<section class="fit-section panel panel--chrome mis-pagos-page__section" data-testid="mis-pagos-payments">
  <h2 class="fit-section__legend"><%= t("billing.mis_pagos.payment_history") %></h2>
  <div class="fit-section__content">
    <p class="mis-pagos-page__section-lead"><%= t("billing.mis_pagos.payments_lead") %></p>
    <% if payments.any? %>
      <div class="mis-pagos-page__card-stack mis-pagos-page__card-stack--history">
        <ul class="mis-pagos-payment-list">
          <% payments.each do |payment| %>
            <%= render "mis_pagos/payment_row", payment: payment %>
          <% end %>
        </ul>
      </div>
    <% else %>
      <p class="mis-pagos-page__empty-text"><%= t("billing.mis_pagos.no_payments") %></p>
    <% end %>
  </div>
</section>
