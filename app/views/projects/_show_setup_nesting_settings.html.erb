<%= turbo_frame_tag dom_id(project, :setup_nesting_settings) do %>
  <% lock_active = workshop_mutations_locked?(project) %>
  <section class="project-show__setup-nesting panel panel--chrome fit-section" data-testid="setup-nesting-settings">
    <h2 class="fit-section__legend"><%= t("projects.form.nesting_settings_legend") %></h2>

    <div class="fit-section__content">
      <fieldset class="pending-payment-lock-fieldset" <%= "disabled" if lock_active %>>
        <%= form_with model: project,
                      url: nesting_parameters_project_path(project),
                      method: :patch,
                      class: "nesting-settings-form",
                      data: { turbo_frame: dom_id(project, :setup_nesting_settings) } do |f| %>
          <% if project.errors.any? %>
            <div class="form-errors form-errors--inline" role="alert">
              <ul>
                <% project.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="panel panel--inset">
            <%= render "nesting_settings", form: f %>
          </div>

          <p class="form-actions form-actions--inline">
            <%= f.submit t("projects.show.apply_nesting_parameters"), class: "btn btn-secondary btn--compact", disabled: lock_active %>
          </p>
        <% end %>
      </fieldset>
    </div>
  </section>
<% end %>
