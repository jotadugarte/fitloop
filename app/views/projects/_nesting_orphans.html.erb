<% if orphans.any? %>
  <section class="nesting-orphans" data-testid="nesting-orphans">
    <h3 class="nesting-orphans__title"><%= t("nesting.orphans_heading") %></h3>

    <div class="nesting-orphans__grid">
      <% orphans.items.each do |orphan| %>
        <article class="orphan-card<%= " orphan-card--split-applied" if orphan.split_applied? %>"
                 data-testid="orphan-card"
                 data-piece-index="<%= orphan.piece_index %>">
          <header class="orphan-card__header">
            <h4 class="orphan-card__title">
              <%= t("nesting.orphan_preview.piece_title", piece_number: orphan.display_number) %>
            </h4>
            <span class="orphan-card__badge" data-testid="orphan-resolution-badge">
              <%= t(
                    orphan.split_applied? ? "nesting.split.badge.split_applied" : "nesting.split.badge.#{orphan.resolution_state}"
                  ) %>
            </span>
            <p class="orphan-card__reason">
              <%= t(
                    "nesting.orphan_reason.#{orphan.reason}",
                    piece_number: orphan.display_number,
                    default: t("nesting.orphan_reason.unknown", piece_number: orphan.display_number)
                  ) %>
            </p>
          </header>

          <% if orphan.split_applied? %>
            <div class="orphan-card__split-applied" data-testid="orphan-split-applied">
              <p class="orphan-card__split-status" data-testid="split-proposal-accepted">
                <%= t("nesting.split.accepted_pending_nest") %>
              </p>
              <% if orphan.split_applied_preview_available? %>
                <div class="split-plan-preview" data-testid="split-plan-preview">
                  <%= split_plan_preview_svg(orphan, css_class: "split-plan-preview__svg") %>
                </div>
              <% end %>
              <ul class="orphan-card__derived-labels" data-testid="orphan-derived-labels">
                <% project.derived_pieces.where(parent_piece_key: orphan.piece_key).order(:sort_order).each do |piece| %>
                  <li class="orphan-card__derived-item">
                    <span class="orphan-card__derived-label" data-testid="orphan-derived-label">
                      <%= derived_piece_title(piece, parent_display_number: orphan.display_number) %>
                    </span>
                    <span class="orphan-card__derived-dimensions" data-testid="orphan-derived-dimensions">
                      <%= derived_piece_dimensions(piece) %>
                    </span>
                  </li>
                <% end %>
              </ul>
            </div>
          <% else %>
          <div class="orphan-card__resolution-actions">
            <%= button_to t("nesting.split.choose_system"),
                          project_orphan_resolution_path(project, orphan.piece_key),
                          method: :patch,
                          params: {
                            orphan_resolution: {
                              resolution_state: "system_split",
                              reason: orphan.reason
                            }
                          },
                          class: "btn btn-secondary btn--small",
                          disabled: !orphan.system_split_enabled?,
                          form: { data: { turbo: true } } %>
            <%= button_to t("nesting.split.choose_manual"),
                          project_orphan_resolution_path(project, orphan.piece_key),
                          method: :patch,
                          params: {
                            orphan_resolution: {
                              resolution_state: "manual",
                              reason: orphan.reason
                            }
                          },
                          class: "btn btn-secondary btn--small",
                          form: { data: { turbo: true } } %>
          </div>

          <% if orphan.preview_available? %>
            <div class="orphan-preview orphan-preview--cad" data-testid="orphan-preview">
              <%= orphan_preview_svg(orphan, css_class: "orphan-preview__svg") %>
            </div>
            <p class="orphan-card__dimensions" data-testid="orphan-dimensions">
              <%= orphan_preview_dimensions(orphan) %>
            </p>
          <% end %>

          <% if orphan.split_not_feasible? %>
            <p class="orphan-card__split-error" data-testid="split-not-feasible" role="alert">
              <%= t("nesting.split.not_feasible") %>
            </p>
            <div class="orphan-card__actions">
              <%= button_to t("nesting.split.reject"),
                            reject_project_orphan_split_proposal_path(project, orphan.piece_key),
                            method: :post,
                            class: "btn btn-secondary btn--small",
                            form: { data: { turbo: true } } %>
            </div>
          <% elsif orphan.split_preview_available? %>
            <div class="split-plan-preview" data-testid="split-plan-preview">
              <%= split_plan_preview_svg(orphan, css_class: "split-plan-preview__svg") %>
            </div>
            <div class="orphan-card__actions">
              <%= button_to t("nesting.split.accept"),
                            accept_project_orphan_split_proposal_path(project, orphan.piece_key),
                            method: :post,
                            class: "btn btn-primary btn--small",
                            form: { data: { turbo: true } } %>
              <%= button_to t("nesting.split.reject"),
                            reject_project_orphan_split_proposal_path(project, orphan.piece_key),
                            method: :post,
                            class: "btn btn-secondary btn--small",
                            form: { data: { turbo: true } } %>
            </div>
          <% end %>

          <% if orphan.manual_resolution? %>
            <div class="orphan-card__manual-flow" data-testid="orphan-manual-flow">
              <p class="orphan-card__manual-intro"><%= t("nesting.split.manual.intro") %></p>
              <ol class="orphan-card__manual-steps">
                <li><%= t("nesting.split.manual.step_1", piece_number: orphan.display_number) %></li>
                <li><%= t("nesting.split.manual.step_2") %></li>
              </ol>
            </div>
          <% end %>
          <% end %>

          <p class="orphan-card__hint">
            <%= t(
                  "nesting.orphan_hint.#{orphan.reason}",
                  default: t("nesting.orphan_hint.unknown")
                ) %>
          </p>
        </article>
      <% end %>
    </div>
  </section>
<% end %>
