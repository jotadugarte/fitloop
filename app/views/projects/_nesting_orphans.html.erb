<% if orphans.any? %>
  <section class="nesting-orphans" data-testid="nesting-orphans">
    <h3 class="nesting-orphans__title"><%= t("nesting.orphans_heading") %></h3>
    <ul class="nesting-orphans__list">
      <% orphans.entries.each do |entry| %>
        <li>
          <%= t(
                "nesting.orphan_reason.#{entry.fetch('reason')}",
                piece_number: entry.fetch("piece_index").to_i + 1,
                default: t("nesting.orphan_reason.unknown", piece_number: entry.fetch("piece_index").to_i + 1)
              ) %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
