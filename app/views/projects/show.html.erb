<%= turbo_stream_from @project %>

<main
  class="page page--wide project-show"
  data-testid="project-show"
  data-controller="nesting-progress-sync"
  data-nesting-progress-sync-url-value="<%= nesting_sync_project_path(@project) %>"
  data-project-status="<%= @project.status %>"
>
  <div class="project-show__hero">
    <h1 class="visually-hidden">
      <%= @project.ephemeral? ? t("projects.show.session_title") : @project.title %>
    </h1>
    <div class="project-show__hero-status">
      <%= render "status_badge", project: @project %>
    </div>
    <%= render "show_welcome" %>
  </div>

  <%= render "show_sheet_inventory", project: @project %>

  <%= render "show_source_dxf_detail", project: @project %>

  <%= render "show_preview_zone",
             project: @project,
             preview: @nesting_preview,
             orphans: @nesting_orphans,
             plan_download_included: @plan_download_included %>

  <%= render "show_actions", project: @project %>

  <section class="project-show__progress">
    <%= render "nesting_progress", **Nesting::ProgressLocals.for(@project, time_limit_notice: @time_limit_notice) %>
  </section>

  <%= render "nesting_parameters", project: @project %>
</main>
