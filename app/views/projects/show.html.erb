<%= turbo_stream_from @project %>

<main class="page">
  <h1><%= @project.title %></h1>
  <p><%= link_to t("projects.show.edit"), edit_project_path(@project) %></p>
  <p><%= link_to t("projects.show.layers"), project_layers_path(@project) %></p>

  <% if @project.nested_dxf.attached? && (@project.completed? || @project.partial?) %>
    <%= link_to t("projects.show.download_nested_dxf"), rails_blob_path(@project.nested_dxf, disposition: "attachment"), data: { testid: "download-nested-dxf" } %>
    <%= button_to t("nesting.renest"), project_nesting_runs_path(@project), method: :post, data: { testid: "renest-nesting" } %>
  <% elsif @project.draft? || @project.ready? || @project.failed? %>
    <%= button_to t("nesting.start"), project_nesting_runs_path(@project), method: :post, data: { testid: "start-nesting" } %>
  <% end %>

  <%= render "nesting_progress", project: @project, eta_overrun: false, time_limit_notice: @time_limit_notice %>
  <%= render "nesting_preview", preview: @nesting_preview %>
  <%= render "nesting_run_history", nesting_runs: @nesting_runs %>

  <% active_run = @project.nesting_runs.order(created_at: :desc).find_by(status: "processing") %>
  <% if active_run %>
    <%= button_to t("nesting.cancel"), cancel_project_nesting_run_path(@project, active_run), method: :post, data: { testid: "cancel-nesting" } %>
  <% end %>

  <p><%= link_to t("projects.show.back"), projects_path %></p>
</main>
