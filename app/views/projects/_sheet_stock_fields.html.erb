<div class="sheet-stock-row" data-testid="sheet-stock-row" data-sortable-row>
  <%= form.hidden_field :sort_order, value: form.object.sort_order || form.index, data: { sort_order_input: true } %>

  <div class="sheet-stock-row__fields">
    <div class="field">
      <%= form.label :width_mm, "Width (mm)" %>
      <%= form.number_field :width_mm, step: 0.1, min: 0, required: true %>
    </div>

    <div class="field">
      <%= form.label :height_mm, "Height (mm)" %>
      <%= form.number_field :height_mm, step: 0.1, min: 0, required: true %>
    </div>

    <div class="field">
      <%= form.label :quantity, "Quantity" %>
      <%= form.number_field :quantity, min: 1, step: 1 %>
    </div>

    <div class="field field--checkbox">
      <%= form.check_box :unlimited_quantity, { checked: form.object.persisted? && form.object.quantity.nil? }, "1", "0" %>
      <%= form.label :unlimited_quantity, "Unlimited quantity" %>
    </div>
  </div>
</div>
