<%= turbo_frame_tag dom_id(project, :nesting_parameters) do %>
  <details class="collapsible-panel panel panel--chrome fit-section" data-testid="nesting-parameters">
    <%= render "projects/fit_section_summary",
               title: t("projects.show.nesting_parameters_title"),
               meta: t("projects.show.nesting_parameters_meta",
                       kerf: project.kerf_mm,
                       margin: project.margin_mm) %>

    <div class="collapsible-panel__body fit-section__content">
      <div class="panel panel--inset">
        <%= form_with model: project,
                      url: nesting_parameters_project_path(project),
                      method: :patch,
                      class: "nesting-parameters__form",
                      data: {
                        controller: "nesting-parameters-autosave",
                        turbo_frame: dom_id(project, :nesting_parameters),
                        action: "change->nesting-parameters-autosave#scheduleSave turbo:submit-end->nesting-parameters-autosave#clearPending"
                      } do |f| %>
          <% if project.errors.any? %>
            <div class="form-errors form-errors--inline" role="alert">
              <ul>
                <% project.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="nesting-parameters__grid">
            <div class="field">
              <%= f.label :kerf_mm, t("projects.form.kerf_mm") %>
              <%= f.number_field :kerf_mm, min: 0, step: 0.1, required: true %>
            </div>
            <div class="field">
              <%= f.label :margin_mm, t("projects.form.margin_mm") %>
              <%= f.number_field :margin_mm, min: 0, step: 0.1, required: true %>
            </div>
          </div>

          <p class="field__hint"><%= t("projects.show.nesting_parameters_hint") %></p>
        <% end %>
      </div>
    </div>
  </details>
<% end %>
