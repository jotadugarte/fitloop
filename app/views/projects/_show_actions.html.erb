<%= turbo_frame_tag dom_id(project, :show_actions) do %>
  <% lock_active = workshop_mutations_locked?(project) %>
  <section class="project-show__actions panel panel--chrome fit-section">
    <h2 class="fit-section__legend"><%= t("projects.show.actions_title") %></h2>

    <div class="fit-section__content">
      <div class="panel panel--inset">
        <div class="action-bar">
          <% if project.nest_with_updated_pieces_available? %>
            <%= button_to t("nesting.nest_updated_pieces"),
                          project_nesting_runs_path(project),
                          method: :post,
                          params: { nest_updated_pieces: true },
                          class: "btn btn-primary",
                          form: { data: { turbo_frame: "_top" } },
                          data: {
                            testid: "nest-updated-pieces",
                            action: "click->collapsible-persistence#forceCollapseDetail"
                          },
                          disabled: lock_active %>
          <% elsif project.nested_dxf.attached? && (project.completed? || project.partial?) %>
            <%= button_to t("nesting.renest"),
                            project_nesting_runs_path(project),
                            method: :post,
                            class: "btn btn-secondary",
                            form: { data: { turbo_frame: "_top" } },
                            data: {
                              testid: "renest-nesting",
                              action: "click->collapsible-persistence#forceCollapseDetail"
                            },
                            disabled: lock_active %>
          <% elsif project.draft? || project.ready? || project.failed? %>
            <%= button_to t("nesting.start"),
                            project_nesting_runs_path(project),
                            method: :post,
                            class: "btn btn-primary",
                            form: { data: { turbo_frame: "_top" } },
                            data: {
                              testid: "start-nesting",
                              action: "click->collapsible-persistence#forceCollapseDetail"
                            },
                            disabled: lock_active %>
          <% end %>

          <% active_run = project.nesting_runs.order(created_at: :desc).find_by(status: "processing") %>
          <% if active_run && !project.processing? %>
            <%= button_to t("nesting.cancel"),
                            cancel_project_nesting_run_path(project, active_run),
                            method: :post,
                            class: "btn btn-secondary",
                            form: { data: { turbo_frame: "_top" } },
                            data: { testid: "cancel-nesting" } %>
          <% end %>
        </div>
      </div>
    </div>
  </section>
<% end %>
