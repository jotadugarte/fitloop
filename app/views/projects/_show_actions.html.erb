<%= turbo_frame_tag dom_id(project, :show_actions) do %>
  <section class="project-show__actions panel panel--chrome fit-section">
    <h2 class="fit-section__legend"><%= t("projects.show.actions_title") %></h2>

    <div class="fit-section__content">
      <div class="panel panel--inset">
        <div class="action-bar">
          <% if project.nested_dxf.attached? && (project.completed? || project.partial?) %>
            <%= link_to t("projects.show.download_nested_dxf"),
                        nested_dxf_project_path(project),
                        class: "btn btn-primary",
                        data: { turbo: false, turbo_frame: "_top", testid: "download-nested-dxf" } %>
            <%= button_to t("nesting.renest"), project_nesting_runs_path(project), method: :post, class: "btn btn-secondary", data: { turbo: false, testid: "renest-nesting" } %>
          <% elsif project.draft? || project.ready? || project.failed? %>
            <%= button_to t("nesting.start"), project_nesting_runs_path(project), method: :post, class: "btn btn-primary", data: { turbo: false, testid: "start-nesting" } %>
          <% end %>

          <% active_run = project.nesting_runs.order(created_at: :desc).find_by(status: "processing") %>
          <% if active_run %>
            <%= button_to t("nesting.cancel"), cancel_project_nesting_run_path(project, active_run), method: :post, class: "btn btn-secondary", data: { turbo: false, testid: "cancel-nesting" } %>
          <% end %>
        </div>
      </div>
    </div>
  </section>
<% end %>
