<%# locals: (project:, context:, input_id:, testid:, hint:, wrap_layers_in_form: false, layers_turbo_frame: nil, expand_layers: false, expanded_attachment_ids: [], lock_active: false) %>
<% wrap_layers_in_form = local_assigns.fetch(:wrap_layers_in_form, false) %>
<% layers_turbo_frame = local_assigns[:layers_turbo_frame] %>
<% expand_layers = local_assigns.fetch(:expand_layers, false) %>
<% expanded_attachment_ids = Array(local_assigns.fetch(:expanded_attachment_ids, [])) %>
<% lock_active = local_assigns.fetch(:lock_active, false) %>
<% checklist_locals = {
  project: project,
  context: context,
  expand_layers: expand_layers,
  expanded_attachment_ids: expanded_attachment_ids,
  lock_active: lock_active
} %>

<div class="project-dxf-upload-section">
  <div class="panel panel--inset project-dxf-upload__hint-card" data-testid="dxf-upload-<%= context %>-hint">
    <p class="project-dxf-upload__hint"><%= hint %></p>
  </div>

  <fieldset class="pending-payment-lock-fieldset panel panel--inset project-dxf-upload"
            <%= "disabled" if lock_active %>
            data-controller="dxf-upload"
            data-dxf-upload-url-value="<%= project_input_dxf_files_path(project, context: context) %>"
            data-dxf-upload-failed-value="<%= t("projects.form.dxf_upload_failed") %>">
    <div class="field project-dxf-file-input"
         data-dxf-upload-empty-files-value="<%= t("projects.form.dxf_upload_no_files") %>"
         data-dxf-upload-files-selected-value="<%= t("projects.form.dxf_upload_files_selected") %>">
      <%= file_field_tag "files[]",
            multiple: true,
            accept: ".dxf,application/dxf",
            id: input_id,
            class: "project-dxf-file-input__input visually-hidden",
            data: {
              dxf_upload_target: "input",
              action: "change->dxf-upload#upload",
              testid: testid
            } %>
      <div class="project-dxf-file-input__control">
        <label for="<%= input_id %>" class="btn btn-secondary project-dxf-file-input__button">
          <%= t("projects.form.dxf_upload_choose") %>
        </label>
        <span class="project-dxf-file-input__status"
              data-dxf-upload-target="fileName"
              aria-live="polite"><%= t("projects.form.dxf_upload_no_files") %></span>
      </div>
    </div>

    <div class="project-dxf-upload__layers">
      <% if wrap_layers_in_form %>
        <% if project.input_dxf_attachments.any? %>
          <%= form_with url: workspace_project_path(project),
                        method: :patch,
                        class: "source-dxf-detail__layers-form",
                        data: { turbo_frame: layers_turbo_frame } do %>
            <%= hidden_field_tag :section, "layers" %>
            <%= render "projects/dxf_layers_checklist", **checklist_locals %>
            <p class="form-actions form-actions--inline">
              <%= submit_tag t("projects.show.apply_layers"), class: "btn btn-secondary btn--compact" %>
            </p>
          <% end %>
        <% else %>
          <p class="dxf-files-layers__empty panel panel--inset"><%= t("projects.form.dxf_layers_prompt") %></p>
        <% end %>
      <% else %>
        <%= render "projects/dxf_files_layers", **checklist_locals %>
      <% end %>
    </div>
  </fieldset>
</div>
