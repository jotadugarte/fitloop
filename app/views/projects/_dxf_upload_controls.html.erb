<%# locals: (project:, context:, input_id:, testid:) %>
<fieldset class="project-dxf-upload project-dxf-upload--inline"
          data-controller="dxf-upload"
          data-dxf-upload-url-value="<%= project_input_dxf_files_path(project, context: context) %>"
          data-dxf-upload-failed-value="<%= t("projects.form.dxf_upload_failed") %>">
  <div class="field">
    <label for="<%= input_id %>">
      <%= t("projects.show.add_dxf_label") %>
      <span class="field__hint"><%= t("projects.show.add_dxf_hint") %></span>
    </label>
    <%= file_field_tag "files[]",
          multiple: true,
          accept: ".dxf,application/dxf",
          id: input_id,
          data: {
            dxf_upload_target: "input",
            action: "change->dxf-upload#upload",
            testid: testid
          } %>
  </div>
</fieldset>
