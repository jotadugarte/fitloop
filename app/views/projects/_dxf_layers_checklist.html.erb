<%# Layer checkboxes grouped by input DXF (no outer turbo frame). %>
<% hint_variant = local_assigns.fetch(:hint_variant, "show") %>
<% if project.input_dxf_attachments.any? %>
  <div class="dxf-files-layers" data-testid="dxf-files-layers">
    <% project.input_dxf_attachments.each do |attachment| %>
      <div class="panel panel--inset dxf-file-entry-wrap">
        <%= render "projects/dxf_file_entry",
                   project: project,
                   attachment: attachment,
                   hint_variant: hint_variant,
                   expand_layers: local_assigns.fetch(:expand_layers, false),
                   expanded_attachment_ids: Array(local_assigns.fetch(:expanded_attachment_ids, [])),
                   lock_active: local_assigns.fetch(:lock_active, false) %>
      </div>
    <% end %>
    <%= render "projects/dxf_layers_section_notes" %>
  </div>
<% else %>
  <p class="dxf-files-layers__empty panel panel--inset"><%= t("projects.form.dxf_layers_prompt") %></p>
<% end %>
