<%= form_with model: project, class: "project-form" do |f| %>
  <% if project.errors.any? %>
    <div class="form-errors" role="alert">
      <h2><%= t("projects.form.errors_heading", count: project.errors.count) %></h2>
      <ul>
        <% project.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :title %>
    <%= f.text_field :title, required: true %>
  </div>

  <div class="field">
    <%= f.label :pin %>
    <%= f.password_field :pin, required: project.new_record?, maxlength: 6, autocomplete: "off" %>
  </div>

  <%= render "sheet_inventory", form: f, project: project %>

  <div class="form-actions">
    <%= f.submit t("projects.form.save_project"), class: "btn btn-primary" %>
  </div>
<% end %>

<script src="/javascripts/sheet_inventory.js" defer data-turbo-track="reload"></script>
