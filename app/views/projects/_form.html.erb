<%= form_with model: project,
              class: "project-form",
              html: {
                multipart: true,
                data: {
                  controller: "sheet-inventory",
                  action: "submit->sheet-inventory#flushOnSubmit",
                  sheet_inventory_summary_unlimited_value: t("projects.form.quantity_unlimited"),
                  sheet_inventory_alert_dimensions_value: t("projects.form.alert_dimensions"),
                  sheet_inventory_alert_quantity_value: t("projects.form.alert_quantity")
                }
              } do |f| %>
  <% if project.errors.any? %>
    <div class="form-errors" role="alert">
      <h2><%= t("projects.form.errors_heading", count: project.errors.count) %></h2>
      <ul>
        <% project.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :title %>
    <%= f.text_field :title, required: true %>
  </div>

  <div class="field">
    <%= f.label :pin %>
    <%= f.password_field :pin, value: project.pin, required: project.new_record?, maxlength: 6, autocomplete: "off" %>
  </div>

  <%= render "sheet_inventory", form: f, project: project, composer_draft: @composer_draft || {} %>

  <%= render "dxf_upload_fields", project: project %>

  <div class="form-actions">
    <%= f.submit t("projects.form.save_project"), class: "btn btn-primary" %>
  </div>
<% end %>
