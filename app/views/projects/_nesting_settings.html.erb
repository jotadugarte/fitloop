<div class="nesting-settings">
  <div class="nesting-settings__grid">
    <div class="field">
      <%= form.label :kerf_mm, t("projects.form.kerf_mm") %>
      <%= form.number_field :kerf_mm, min: 0, step: 0.1, required: true %>
      <p class="field__hint"><%= t("projects.form.kerf_mm_hint") %></p>
    </div>

    <div class="field">
      <%= form.label :margin_mm, t("projects.form.margin_mm") %>
      <%= form.number_field :margin_mm, min: 0, step: 0.1, required: true %>
      <p class="field__hint"><%= t("projects.form.margin_mm_hint") %></p>
    </div>
  </div>
</div>
