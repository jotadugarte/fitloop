<%= turbo_frame_tag dom_id(project, :nesting_preview) do %>
<% heading_tag = local_assigns.fetch(:heading_level, 2) == 3 ? :h3 : :h2 %>
<section class="nesting-preview-panel" data-testid="nesting-preview-panel">
  <%= content_tag heading_tag, t("projects.preview.title"), class: "nesting-preview-panel__title" %>

  <% if preview.available? %>
    <p data-testid="preview-sheet-count"><%= t("projects.preview.sheet_count", count: preview.sheet_count) %></p>
    <div class="nesting-preview nesting-preview--cad" data-testid="nesting-preview">
      <%= nesting_preview_svg(preview, css_class: "nesting-preview__svg", testid: "nesting-preview-svg") %>
    </div>
  <% else %>
    <div class="nesting-preview nesting-preview--empty" data-testid="nesting-preview-empty">
      <p><%= t("projects.preview.empty") %></p>
    </div>
  <% end %>
</section>
<% end %>
