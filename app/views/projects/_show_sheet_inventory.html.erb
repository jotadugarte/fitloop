<%= turbo_frame_tag dom_id(project, :sheet_inventory) do %>
  <% sheet_count = project.sheet_stocks.count %>
  <details class="collapsible-panel panel panel--chrome fit-section"
           data-testid="show-sheet-inventory"
           data-collapsible-key="workshop-sheet-inventory">
    <%= render "projects/fit_section_summary",
               title: t("projects.form.sheet_stocks_legend"),
               meta: t("projects.show.sheet_inventory_meta", count: sheet_count) %>

    <div class="collapsible-panel__body fit-section__content">
      <%= form_with model: project,
                    url: workspace_project_path(project),
                    method: :patch,
                    class: "project-form",
                    html: {
                      data: {
                        controller: "sheet-inventory",
                        action: "submit->sheet-inventory#flushOnSubmit",
                        turbo_frame: dom_id(project, :sheet_inventory),
                        sheet_inventory_summary_unlimited_value: t("projects.form.quantity_unlimited"),
                        sheet_inventory_alert_dimensions_value: t("projects.form.alert_dimensions"),
                        sheet_inventory_alert_quantity_value: t("projects.form.alert_quantity"),
                        sheet_inventory_alert_single_unlimited_value: t("projects.form.alert_single_unlimited"),
                        sheet_inventory_has_unlimited_value: project.sheet_stocks.any? { |stock| stock.quantity.nil? }
                      }
                    } do |f| %>
        <%= hidden_field_tag :section, "sheets" %>

        <% if project.errors.any? %>
          <div class="form-errors form-errors--inline" role="alert">
            <ul>
              <% project.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= render "sheet_inventory", form: f, project: project, composer_draft: {} %>

        <p class="form-actions form-actions--inline">
          <%= f.submit t("projects.show.save_sheets"), class: "btn btn-secondary btn--compact" %>
        </p>
      <% end %>
    </div>
  </details>
<% end %>
