<div class="admin-dashboard">
  <header class="admin-dashboard__header" style="margin-bottom: 2rem;">
    <h1 class="admin-dashboard__title">Bitácora de Usuarios</h1>
    <p class="admin-dashboard__tagline">Listado y búsqueda de la actividad de los usuarios registrados</p>
  </header>

  <!-- Search form -->
  <div class="panel panel--solid" style="margin-bottom: 2rem; padding: 1.25rem;">
    <%= form_with url: admin_usuarios_path, method: :get, local: true, class: "users-search-form", style: "display: flex; gap: 1rem; align-items: end;" do |f| %>
      <div class="field" style="flex: 1; margin: 0;">
        <%= f.label :q, "Buscar por Nombre o Correo", class: "field__label" %>
        <%= f.text_field :q, value: @q, class: "input", placeholder: "Escribe para buscar...", style: "width: 100%;" %>
      </div>
      <div class="form-actions" style="margin: 0;">
        <%= f.submit "Buscar", class: "btn btn-primary" %>
        <% if @q.present? %>
          <%= link_to "Limpiar", admin_usuarios_path, class: "btn btn-secondary", style: "text-decoration: none;" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Users Table -->
  <div class="panel panel--solid" style="padding: 0; overflow-x: auto;">
    <table class="sheet-inventory-table" style="width: 100%; border-collapse: collapse; text-align: left;">
      <thead>
        <tr style="background: var(--fit-navy-dark); color: white;">
          <th style="padding: 0.75rem 1rem;">ID</th>
          <th style="padding: 0.75rem 1rem;">Nombre</th>
          <th style="padding: 0.75rem 1rem;">Correo Electrónico</th>
          <th style="padding: 0.75rem 1rem;">Admin</th>
          <th style="padding: 0.75rem 1rem;">Fecha de Registro</th>
          <th style="padding: 0.75rem 1rem; text-align: right;">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if @users.any? %>
          <% @users.each do |user| %>
            <tr style="border-bottom: 1px solid var(--fit-border);">
              <td style="padding: 0.75rem 1rem;"><%= user.id %></td>
              <td style="padding: 0.75rem 1rem; font-weight: 600;"><%= user.name %></td>
              <td style="padding: 0.75rem 1rem;"><%= user.email %></td>
              <td style="padding: 0.75rem 1rem;">
                <% if user.admin? %>
                  <span class="badge badge--succeeded">Sí</span>
                <% else %>
                  <span class="badge badge--pending">No</span>
                <% end %>
              </td>
              <td style="padding: 0.75rem 1rem;"><%= user.created_at.strftime("%Y-%m-%d %H:%M") %></td>
              <td style="padding: 0.75rem 1rem; text-align: right;">
                <%= link_to "Ver Bitácora", admin_usuario_path(user), class: "btn btn-secondary btn--compact", style: "text-decoration: none;" %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="6" style="padding: 2rem; text-align: center; color: var(--fit-text-muted);">
              No se encontraron usuarios que coincidan con la búsqueda.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
