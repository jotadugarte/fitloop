<div class="admin-dashboard">
  <header class="admin-dashboard__header">
    <h1 class="admin-dashboard__title">Bitácora de Usuarios</h1>
    <p class="admin-dashboard__tagline">Listado y búsqueda de la actividad de los usuarios registrados</p>
  </header>

  <!-- Search form -->
  <%= form_with url: admin_usuarios_path, method: :get, local: true, class: "fit-section admin-ventas-filters" do |f| %>
    <h2 class="fit-section__legend">Búsqueda de Usuarios</h2>
    <div class="admin-ventas-filters__grid" style="grid-template-columns: 1fr auto; align-items: end;">
      <div>
        <%= f.label :q, "Buscar por Nombre o Correo", class: "admin-stat-card__label admin-ventas-field__label" %>
        <%= f.text_field :q, value: @q, class: "admin-ventas-field__input", placeholder: "Escribe para buscar..." %>
      </div>
      <div class="admin-ventas-filters__actions">
        <%= f.submit "Buscar", class: "btn btn-secondary" %>
        <% if @q.present? %>
          <%= link_to "Limpiar", admin_usuarios_path, class: "btn btn-secondary btn--link" %>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Users Table -->
  <section class="fit-section">
    <h2 class="fit-section__legend">Listado de Usuarios</h2>
    <div class="table-container" style="margin-left: -1.25rem; margin-right: -1.25rem; padding-left: 1.25rem; padding-right: 1.25rem; margin-bottom: -1.15rem;">
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Correo Electrónico</th>
            <th>Admin</th>
            <th>Fecha de Registro</th>
            <th class="text-right">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if @users.any? %>
            <% @users.each do |user| %>
              <tr>
                <td class="font-mono text-sm"><%= user.id %></td>
                <td class="font-bold"><%= user.name.presence || "—" %></td>
                <td><%= user.email %></td>
                <td>
                  <% if user.admin? %>
                    <span class="badge badge--succeeded">Sí</span>
                  <% else %>
                    <span class="badge badge--pending">No</span>
                  <% end %>
                </td>
                <td class="admin-table__date"><%= user.created_at.strftime("%Y-%m-%d %H:%M") %></td>
                <td class="text-right">
                  <%= link_to "Ver Bitácora", admin_usuario_path(user), class: "btn btn-secondary btn--compact", style: "text-decoration: none;" %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="admin-empty-state">
                No se encontraron usuarios que coincidan con la búsqueda.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>
