<div class="admin-dashboard">
  <header class="admin-dashboard__header admin-dashboard__header--split">
    <div>
      <h1 class="admin-dashboard__title">Bitácora de <%= @user.name.presence || @user.email %></h1>
      <p class="admin-dashboard__tagline">Historial de eventos y acciones registradas para este usuario</p>
    </div>
    <div>
      <%= link_to "← Volver a Usuarios", admin_usuarios_path, class: "btn btn-secondary", style: "text-decoration: none;" %>
    </div>
  </header>

  <!-- User Details Card -->
  <section class="fit-section">
    <h2 class="fit-section__legend">Información del Usuario</h2>
    <div class="detail-grid">
      <div class="detail-item">
        <div class="detail-item__label">ID de Usuario</div>
        <div class="detail-item__value font-mono"><%= @user.id %></div>
      </div>
      <div class="detail-item">
        <div class="detail-item__label">Nombre</div>
        <div class="detail-item__value"><%= @user.name.presence || "—" %></div>
      </div>
      <div class="detail-item">
        <div class="detail-item__label">Correo Electrónico</div>
        <div class="detail-item__value"><%= @user.email %></div>
      </div>
      <div class="detail-item">
        <div class="detail-item__label">Fecha de Registro</div>
        <div class="detail-item__value"><%= @user.created_at.strftime("%Y-%m-%d %H:%M") %></div>
      </div>
    </div>
  </section>

  <!-- Timeline section -->
  <div class="fit-section">
    <h2 class="fit-section__legend">Línea de Tiempo de Actividad</h2>
    
    <div class="fit-section__content" style="padding-top: 1.5rem;">
      <% if @events.any? %>
        <div class="admin-timeline">
          <% @events.each do |event| %>
            <div class="admin-timeline__item">
              <div class="admin-timeline__dot <%= 'admin-timeline__dot--critical' if event.priority == 'critical' %>"></div>
              
              <div class="admin-timeline__header">
                <span class="admin-timeline__event-type"><%= event_label(event.event_type) %></span>
                <span class="admin-timeline__time"><%= event.occurred_at.strftime("%Y-%m-%d %H:%M:%S") %></span>
              </div>
              
              <div class="admin-timeline__body">
                <div><strong>Tipo:</strong> <code><%= event.event_type %></code></div>
                <% if event.ip.present? || event.country_code.present? %>
                  <div class="admin-timeline__meta">
                    IP: <%= event.ip || "—" %> (<%= event.country_code || "—" %>) | Locale: <%= event.locale || "—" %>
                  </div>
                <% end %>
                <% if event.properties.present? %>
                  <div class="admin-timeline__properties">
                    <span class="admin-timeline__properties-label">Propiedades:</span>
                    <pre class="admin-timeline__properties-pre"><%= JSON.pretty_generate(event.properties) %></pre>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="admin-empty-state">
          No hay eventos registrados para este usuario en la bitácora.
        </p>
      <% end %>
    </div>
  </div>
</div>
