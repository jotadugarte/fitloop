<%
  status_labels = {
    "succeeded" => "Exitoso",
    "pending" => "Pendiente",
    "failed" => "Fallido"
  }

  payment_method_labels = {
    "card_usd" => "Tarjeta USD",
    "card_crc" => "Tarjeta CRC",
    "sinpe_crc" => "SINPE CRC"
  }

  purpose_labels = {
    "single_download" => "Descarga suelta",
    "plan_subscription" => "Plan"
  }
%>

<div class="admin-dashboard">
  <header class="admin-dashboard__header" style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
    <div>
      <h1 class="admin-dashboard__title">Ventas y Reporte de Pagos</h1>
      <p class="admin-dashboard__tagline">Historial detallado de transacciones, desglose financiero para Hacienda y exportación de datos.</p>
    </div>
    <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
      <%= link_to admin_export_ventas_xlsx_path(request.query_parameters), class: "btn btn-primary", style: "display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; padding: 0.5rem 0.85rem;" do %>
        <span>⬇ Exportar Reporte (.xlsx)</span>
      <% end %>
    </div>
  </header>

  <!-- Filters Section -->
  <%= form_with url: admin_ventas_path, method: :get, local: true, class: "admin-panel", style: "margin-bottom: 2rem;" do |f| %>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.25rem; align-items: start;">
      <div>
        <label for="search" class="admin-stat-card__label" style="display: block; margin-bottom: 0.5rem;">Buscar</label>
        <%= f.text_field :search, value: params[:search], placeholder: "Nombre, email, ref...", id: "search", style: "width: 100%; padding: 0.45rem 0.6rem; border-radius: 4px; border: 1px solid var(--fit-border, #c5d0dc); font-size: 0.85rem;" %>
      </div>
      
      <div>
        <span class="admin-stat-card__label" style="display: block; margin-bottom: 0.5rem;">Estado</span>
        <div style="display: flex; flex-direction: column; gap: 0.35rem; padding-top: 0.15rem;">
          <label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer; color: var(--fit-navy-dark, #1e3a5f); font-weight: 500;">
            <%= check_box_tag "status[]", "succeeded", Array(params[:status]).include?("succeeded") %> <%= status_labels["succeeded"].upcase %>
          </label>
          <label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer; color: var(--fit-navy-dark, #1e3a5f); font-weight: 500;">
            <%= check_box_tag "status[]", "pending", Array(params[:status]).include?("pending") %> <%= status_labels["pending"].upcase %>
          </label>
          <label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer; color: var(--fit-navy-dark, #1e3a5f); font-weight: 500;">
            <%= check_box_tag "status[]", "failed", Array(params[:status]).include?("failed") %> <%= status_labels["failed"].upcase %>
          </label>
        </div>
      </div>

      <div>
        <span class="admin-stat-card__label" style="display: block; margin-bottom: 0.5rem;">Método de Pago</span>
        <div style="display: flex; flex-direction: column; gap: 0.35rem; padding-top: 0.15rem;">
          <label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer; color: var(--fit-navy-dark, #1e3a5f); font-weight: 500;">
            <%= check_box_tag "payment_method[]", "card_usd", Array(params[:payment_method]).include?("card_usd") %> <%= payment_method_labels["card_usd"] %>
          </label>
          <label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer; color: var(--fit-navy-dark, #1e3a5f); font-weight: 500;">
            <%= check_box_tag "payment_method[]", "card_crc", Array(params[:payment_method]).include?("card_crc") %> <%= payment_method_labels["card_crc"] %>
          </label>
          <label style="font-size: 0.85rem; display: flex; align-items: center; gap: 0.35rem; cursor: pointer; color: var(--fit-navy-dark, #1e3a5f); font-weight: 500;">
            <%= check_box_tag "payment_method[]", "sinpe_crc", Array(params[:payment_method]).include?("sinpe_crc") %> <%= payment_method_labels["sinpe_crc"] %>
          </label>
        </div>
      </div>

      <div>
        <label for="start_date" class="admin-stat-card__label" style="display: block; margin-bottom: 0.5rem;">Desde</label>
        <%= f.date_field :start_date, value: params[:start_date], id: "start_date", style: "width: 100%; padding: 0.45rem 0.6rem; border-radius: 4px; border: 1px solid var(--fit-border, #c5d0dc); font-size: 0.85rem;" %>
      </div>

      <div>
        <label for="end_date" class="admin-stat-card__label" style="display: block; margin-bottom: 0.5rem;">Hasta</label>
        <%= f.date_field :end_date, value: params[:end_date], id: "end_date", style: "width: 100%; padding: 0.45rem 0.6rem; border-radius: 4px; border: 1px solid var(--fit-border, #c5d0dc); font-size: 0.85rem;" %>
      </div>

      <div style="display: flex; gap: 0.5rem; align-self: end; width: 100%;">
        <%= f.submit "Filtrar", class: "btn btn-secondary", style: "flex: 1; padding: 0.5rem; font-size: 0.85rem; font-weight: 500;" %>
        <%= link_to "Limpiar", admin_ventas_path, class: "btn btn-secondary", style: "flex: 1; text-align: center; padding: 0.5rem; text-decoration: none; font-size: 0.85rem; font-weight: 500; display: inline-block; line-height: 1.5;" %>
      </div>
    </div>
  <% end %>

  <!-- Declaration summaries (CRC vs USD export) -->
  <% crc_totals = @declaration_totals.fetch(:crc) %>
  <% usd_totals = @declaration_totals.fetch(:usd) %>

  <%= render "declaration_panel",
        title: "Declaración CRC — ventas locales (IVA 13%)",
        subtitle: "Transacciones en colones para factura/tiquete electrónico nacional.",
        totals: crc_totals,
        currency: :crc,
        show_iva: true %>

  <%= render "declaration_panel",
        title: "Declaración USD — factura de exportación",
        subtitle: "Transacciones en dólares (sin IVA). Usar fecha del pago para tipo de cambio BCCR.",
        totals: usd_totals,
        currency: :usd,
        show_iva: false %>

  <!-- Activity counters -->
  <div class="admin-summary-grid" style="margin-bottom: 2rem;">
    <div class="admin-stat-card">
      <div class="admin-stat-card__label">Transacciones Exitosas</div>
      <div class="admin-stat-card__value"><%= @succeeded_count %></div>
      <div class="admin-stat-card__meta">CRC <%= crc_totals.count %> · USD <%= usd_totals.count %></div>
    </div>

    <div class="admin-stat-card">
      <div class="admin-stat-card__label">Transacciones Fallidas</div>
      <div class="admin-stat-card__value"><%= @failed_count %></div>
      <div class="admin-stat-card__meta">Con error</div>
    </div>

    <div class="admin-stat-card">
      <div class="admin-stat-card__label">Transacciones Pendientes</div>
      <div class="admin-stat-card__value"><%= @pending_count %></div>
      <div class="admin-stat-card__meta">En espera</div>
    </div>
  </div>

  <%= render "transactions_table",
        title: "Transacciones en colones (CRC)",
        subtitle: "Ventas locales sujetas a IVA — #{@crc_listing.total_count} encontrada(s).",
        listing: @crc_listing,
        direction: @direction,
        currency_label: "colones" %>

  <%= render "transactions_table",
        title: "Transacciones en dólares (USD)",
        subtitle: "Factura de exportación — #{@usd_listing.total_count} encontrada(s).",
        listing: @usd_listing,
        direction: @direction,
        currency_label: "dólares" %>
</div>

<!-- Modals Detail Container -->
<% @payments.each do |payment| %>
  <dialog id="modal-<%= payment.id %>" class="admin-modal">
    <div class="admin-modal__header">
      <h3 class="admin-modal__title">Detalle de Pago: <%= payment.purchase_reference.presence || "##{payment.id}" %></h3>
      <button type="button" class="admin-modal__close" onclick="document.getElementById('modal-<%= payment.id %>').close()">&times;</button>
    </div>
    <div class="admin-modal__body">
      <div class="detail-grid">
        <div class="detail-item">
          <div class="detail-item__label">Nombre del Comprador</div>
          <div class="detail-item__value"><%= payment.purchaser_name.presence || "—" %></div>
        </div>
        <div class="detail-item">
          <div class="detail-item__label">Email del Comprador</div>
          <div class="detail-item__value" style="word-break: break-all;"><%= payment.purchaser_email.presence || "—" %></div>
        </div>
        <div class="detail-item">
          <div class="detail-item__label">ID de Usuario</div>
          <div class="detail-item__value"><%= payment.user_id %></div>
        </div>
        <div class="detail-item">
          <div class="detail-item__label">Identificación SINPE</div>
          <div class="detail-item__value"><%= payment.sinpe_transfer_identification.presence || "—" %></div>
        </div>
        <div class="detail-item">
          <div class="detail-item__label">Móvil SINPE</div>
          <div class="detail-item__value"><%= payment.sinpe_transfer_mobile_number.presence || "—" %></div>
        </div>
        <div class="detail-item">
          <div class="detail-item__label">ID Intento de Pago (Gateway)</div>
          <div class="detail-item__value" style="word-break: break-all;"><%= payment.onvo_payment_intent_id.presence || "—" %></div>
        </div>
        <div class="detail-item">
          <div class="detail-item__label">Método de Pago</div>
          <div class="detail-item__value"><%= payment_method_labels[payment.payment_method] || payment.payment_method.to_s.upcase.gsub('_', ' ') %></div>
        </div>
        <div class="detail-item">
          <div class="detail-item__label">Estado</div>
          <div class="detail-item__value">
            <span class="badge badge--<%= payment.status %>"><%= status_labels[payment.status] || payment.status.upcase %></span>
          </div>
        </div>
        <div class="detail-item">
          <div class="detail-item__label">Código CAByS</div>
          <div class="detail-item__value font-mono"><%= payment.cabys_code.presence || "—" %></div>
        </div>
        <div class="detail-item">
          <div class="detail-item__label">Fecha</div>
          <div class="detail-item__value"><%= payment.created_at.in_time_zone("America/Costa_Rica").strftime("%d/%m/%Y %H:%M:%S CR") %></div>
        </div>
      </div>

      <h4 style="margin-top: 1.5rem; margin-bottom: 0.75rem; border-bottom: 1px solid var(--fit-border, #c5d0dc); padding-bottom: 0.25rem; color: var(--fit-navy-dark, #1e3a5f); font-size: 0.95rem;">Desglose Financiero</h4>
      <div class="detail-grid">
        <div class="detail-item">
          <div class="detail-item__label">Precio de Lista</div>
          <div class="detail-item__value font-mono"><%= format_billing_amount(payment.list_price, payment.currency.to_sym) %></div>
        </div>
        <div class="detail-item">
          <div class="detail-item__label">Descuento</div>
          <div class="detail-item__value font-mono"><%= format_billing_amount(payment.discount_amount, payment.currency.to_sym) %></div>
        </div>
        <div class="detail-item">
          <div class="detail-item__label">Subtotal</div>
          <div class="detail-item__value font-mono"><%= format_billing_amount(payment.subtotal, payment.currency.to_sym) %></div>
        </div>
        <div class="detail-item">
          <div class="detail-item__label">Impuesto (IVA 13%)</div>
          <div class="detail-item__value font-mono"><%= format_billing_amount(payment.tax_amount, payment.currency.to_sym) %></div>
        </div>
        <div class="detail-item" style="grid-column: 1 / -1; background: var(--fit-bg, #f0f3f7); padding: 0.5rem; border-radius: 4px;">
          <div class="detail-item__label">Total Transado</div>
          <div class="detail-item__value font-mono" style="font-size: 1.2rem; font-weight: 700;">
            <% actual_total = payment.total_amount.to_f > 0 ? payment.total_amount : payment.amount %>
            <%= format_billing_amount(actual_total, payment.currency.to_sym) %>
          </div>
        </div>
      </div>
    </div>
    <div class="admin-modal__footer">
      <button type="button" class="btn btn-secondary" onclick="document.getElementById('modal-<%= payment.id %>').close()">Cerrar</button>
    </div>
  </dialog>
<% end %>
