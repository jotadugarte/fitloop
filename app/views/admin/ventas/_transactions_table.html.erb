<%
  status_labels = {
    "succeeded" => "Exitoso",
    "pending" => "Pendiente",
    "failed" => "Fallido"
  }

  payment_method_labels = {
    "card_usd" => "Tarjeta USD",
    "card_crc" => "Tarjeta CRC",
    "sinpe_crc" => "SINPE CRC"
  }

  purpose_labels = {
    "single_download" => "Descarga suelta",
    "plan_subscription" => "Plan"
  }
%>

<section class="admin-panel" style="margin-bottom: 2rem;">
  <div class="admin-panel__header">
    <h2 class="admin-panel__title"><%= title %></h2>
    <p style="margin: 0.35rem 0 0; color: var(--fit-text-muted, #5c6d82); font-size: 0.85rem;"><%= subtitle %></p>
  </div>

  <div class="table-container">
    <% if listing.payments.any? %>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Ref / ID</th>
            <th>Comprador</th>
            <th>Concepto</th>
            <th>Método</th>
            <th>Subtotal</th>
            <th>Impuesto</th>
            <th class="text-right">Total</th>
            <th class="text-center">Estado</th>
            <th>
              <% next_direction = direction == "desc" ? "asc" : "desc" %>
              <%= link_to admin_ventas_path(request.query_parameters.merge(direction: next_direction)), style: "color: inherit; text-decoration: none; display: inline-flex; align-items: center; gap: 0.25rem;" do %>
                <span>Fecha</span>
                <span><%= direction == "desc" ? "↓" : "↑" %></span>
              <% end %>
            </th>
            <th class="text-center">Detalle</th>
          </tr>
        </thead>
        <tbody>
          <% listing.payments.each do |payment| %>
            <% actual_total = payment.total_amount.to_f > 0 ? payment.total_amount : payment.amount %>
            <tr>
              <td class="font-mono text-sm">
                <%= payment.purchase_reference.presence || "# #{payment.id}" %>
              </td>
              <td>
                <div style="font-weight: 500;"><%= payment.purchaser_name.presence || "Usuario ##{payment.user_id}" %></div>
                <div class="text-muted font-mono" style="font-size: 0.75rem;"><%= payment.purchaser_email.presence || payment.user&.email %></div>
              </td>
              <td>
                <span style="font-size: 0.8rem; font-weight: 500;">
                  <%= purpose_labels[payment.purpose] || payment.purpose.to_s.humanize %>
                </span>
              </td>
              <td>
                <span class="font-mono" style="font-size: 0.8rem;">
                  <%= payment_method_labels[payment.payment_method]&.upcase || payment.payment_method.to_s.upcase.gsub("_", " ") %>
                </span>
              </td>
              <td class="font-mono" style="font-size: 0.85rem;">
                <%= format_billing_amount(payment.subtotal, payment.currency.to_sym) %>
              </td>
              <td class="font-mono" style="font-size: 0.85rem;">
                <%= format_billing_amount(payment.tax_amount, payment.currency.to_sym) %>
              </td>
              <td class="text-right font-mono font-bold">
                <%= format_billing_amount(actual_total, payment.currency.to_sym) %>
              </td>
              <td class="text-center">
                <span class="badge badge--<%= payment.status %>">
                  <%= status_labels[payment.status]&.upcase || payment.status.upcase %>
                </span>
              </td>
              <td style="font-size: 0.8rem; white-space: nowrap;">
                <%= payment.created_at.in_time_zone("America/Costa_Rica").strftime("%d/%m/%y %H:%M") %>
              </td>
              <td class="text-center">
                <button type="button" class="btn btn-secondary btn--compact" onclick="document.getElementById('modal-<%= payment.id %>').showModal()">
                  Ver
                </button>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="admin-empty-state">No hay transacciones en <%= currency_label %> con los filtros actuales.</div>
    <% end %>
  </div>

  <% if listing.total_pages > 1 %>
    <div style="display: flex; justify-content: center; gap: 0.5rem; margin-top: 1.5rem;">
      <% if listing.page > 1 %>
        <%= link_to "« Ant", admin_ventas_path(request.query_parameters.merge(page: listing.page - 1)), class: "btn btn-secondary btn--compact", style: "text-decoration: none;" %>
      <% end %>
      <span style="align-self: center; font-size: 0.9rem; font-weight: 500; color: var(--fit-navy-dark, #1e3a5f);">
        Pág. <%= listing.page %> de <%= listing.total_pages %> (<%= listing.total_count %>)
      </span>
      <% if listing.page < listing.total_pages %>
        <%= link_to "Sig »", admin_ventas_path(request.query_parameters.merge(page: listing.page + 1)), class: "btn btn-secondary btn--compact", style: "text-decoration: none;" %>
      <% end %>
    </div>
  <% end %>
</section>
