<div class="admin-dashboard">
  <header class="admin-dashboard__header admin-dashboard__header--split">
    <div>
      <h1 class="admin-dashboard__title"><%= t("admin.analytics.title") %></h1>
      <p class="admin-dashboard__tagline"><%= t("admin.analytics.tagline") %></p>
    </div>
    <div class="admin-ventas-actions">
      <%= link_to admin_export_analytics_path(request.query_parameters), class: "btn btn-primary admin-ventas-export-btn" do %>
        <span><%= t("admin.analytics.export_events") %></span>
      <% end %>
    </div>
  </header>

  <% if @bot_heuristic %>
    <div class="panel panel--alert">
      <p style="margin: 0; font-weight: 600; color: var(--fit-alert-text);">
        <%= t("admin.analytics.bot_alert", threshold: Analytics::Thresholds.low_priority_events_per_hour) %>
      </p>
    </div>
  <% end %>

  <%= form_with url: admin_analytics_path, method: :get, local: true, class: "fit-section admin-ventas-filters" do |f| %>
    <h2 class="fit-section__legend"><%= t("admin.analytics.filters.legend") %></h2>
    <div class="admin-ventas-filters__grid">
      <div>
        <%= f.label :start_date, t("admin.analytics.filters.start_date"), class: "admin-stat-card__label admin-ventas-field__label" %>
        <%= f.date_field :start_date, value: @start_date, class: "admin-ventas-field__input" %>
      </div>

      <div>
        <%= f.label :end_date, t("admin.analytics.filters.end_date"), class: "admin-stat-card__label admin-ventas-field__label" %>
        <%= f.date_field :end_date, value: @end_date, class: "admin-ventas-field__input" %>
      </div>

      <div>
        <%= f.label :locale, t("admin.analytics.filters.locale"), class: "admin-stat-card__label admin-ventas-field__label" %>
        <%= f.select :locale, options_for_select([[t("admin.analytics.filters.all"), ""]] + @available_locales.map { |l| [l == "es" ? t("admin.analytics.filters.locale_es") : (l == "en" ? t("admin.analytics.filters.locale_en") : l.upcase), l] }, @locale), {}, class: "admin-ventas-field__input" %>
      </div>

      <div>
        <%= f.label :payment_method, t("admin.analytics.filters.payment_method"), class: "admin-stat-card__label admin-ventas-field__label" %>
        <%= f.select :payment_method, options_for_select([[t("admin.analytics.filters.all"), ""]] + @available_payment_methods.map { |pm| [Admin::PaymentDisplayLabels.payment_method_label(pm), pm] }, @payment_method), {}, class: "admin-ventas-field__input" %>
      </div>

      <div>
        <%= f.label :currency, t("admin.analytics.filters.currency"), class: "admin-stat-card__label admin-ventas-field__label" %>
        <%= f.select :currency, options_for_select([[t("admin.analytics.filters.all"), ""]] + @available_currencies.map { |c| [c.to_s.downcase == "crc" ? t("admin.analytics.filters.currency_crc") : (c.to_s.downcase == "usd" ? t("admin.analytics.filters.currency_usd") : c.upcase), c] }, @currency), {}, class: "admin-ventas-field__input" %>
      </div>

      <div class="admin-ventas-filters__actions">
        <%= f.submit t("admin.analytics.filters.submit"), class: "btn btn-secondary" %>
        <%= link_to t("admin.analytics.filters.clear"), admin_analytics_path, class: "btn btn-secondary btn--link" %>
      </div>
    </div>
  <% end %>

  <section class="fit-section">
    <h2 class="fit-section__legend"><%= t("admin.analytics.conversion.legend") %></h2>
    <div class="analytics-grid" style="margin-bottom: 0;">
      <div class="metric-card">
        <h3 class="metric-card__title"><%= t("admin.analytics.conversion.workspace_started") %></h3>
        <div class="metric-card__value"><%= @funnel_counts["workspace_started"] %></div>
        <p class="metric-card__subtitle"><%= t("admin.analytics.conversion.workspace_started_sub").html_safe %></p>
      </div>

      <div class="metric-card">
        <h3 class="metric-card__title"><%= t("admin.analytics.conversion.first_dxf") %></h3>
        <div class="metric-card__value"><%= @funnel_counts["first_dxf_uploaded"] %></div>
        <p class="metric-card__subtitle"><%= t("admin.analytics.conversion.first_dxf_sub").html_safe %></p>
      </div>

      <div class="metric-card">
        <h3 class="metric-card__title"><%= t("admin.analytics.conversion.nest_completed") %></h3>
        <div class="metric-card__value"><%= @funnel_counts["nest_completed"] %></div>
        <p class="metric-card__subtitle"><%= t("admin.analytics.conversion.nest_completed_sub").html_safe %></p>
      </div>

      <div class="metric-card <%= 'metric--alert' if @conversion_alert %>">
        <h3 class="metric-card__title"><%= t("admin.analytics.conversion.paywall") %></h3>
        <div class="metric-card__value"><%= @conversion_percent %>%</div>
        <p class="metric-card__subtitle">
          <% if @conversion_alert %>
            <%= t("admin.analytics.conversion.below_min", min: Analytics::Thresholds.funnel_conversion_min_percent) %>
          <% else %>
            <%= t("admin.analytics.conversion.normal", min: Analytics::Thresholds.funnel_conversion_min_percent) %>
          <% end %>
        </p>
      </div>
    </div>
  </section>

  <section class="fit-section">
    <h2 class="fit-section__legend"><%= t("admin.analytics.monetization.legend") %></h2>
    <div class="analytics-grid" style="margin-bottom: 0;">
      <div class="metric-card">
        <h3 class="metric-card__title"><%= t("admin.analytics.monetization.single_payments") %></h3>
        <div class="metric-card__value"><%= @single_payments_count %></div>
        <p class="metric-card__subtitle"><%= t("admin.analytics.monetization.single_payments_sub") %></p>
      </div>

      <div class="metric-card">
        <h3 class="metric-card__title"><%= t("admin.analytics.monetization.plan_payments") %></h3>
        <div class="metric-card__value"><%= @plan_payments_count %></div>
        <p class="metric-card__subtitle"><%= t("admin.analytics.monetization.plan_payments_sub") %></p>
      </div>

      <div class="metric-card">
        <h3 class="metric-card__title"><%= t("admin.analytics.monetization.plans_1_month") %></h3>
        <div class="metric-card__value"><%= @plans_1_month %></div>
        <p class="metric-card__subtitle"><%= t("admin.analytics.monetization.plans_1_month_sub") %></p>
      </div>

      <div class="metric-card">
        <h3 class="metric-card__title"><%= t("admin.analytics.monetization.plans_multi") %></h3>
        <div class="metric-card__value"><%= @plans_2_month + @plans_4_month %></div>
        <p class="metric-card__subtitle"><%= t("admin.analytics.monetization.plans_multi_sub", two: @plans_2_month, four: @plans_4_month).html_safe %></p>
      </div>

      <div class="metric-card">
        <h3 class="metric-card__title"><%= t("admin.analytics.monetization.exhausted_quotas") %></h3>
        <div class="metric-card__value"><%= @exhausted_quotas_count %></div>
        <p class="metric-card__subtitle"><%= t("admin.analytics.monetization.exhausted_quotas_sub") %></p>
      </div>
    </div>
  </section>

  <div class="fit-section">
    <h2 class="fit-section__legend"><%= t("admin.analytics.funnel_chart") %></h2>
    <div class="analytics-chart-container" style="height: 300px; margin-bottom: 0;"
         data-controller="admin-chart"
         data-admin-chart-labels-value="<%= Analytics::FunnelStages::ORDERED.map { |stage| event_label(stage) }.to_json %>"
         data-admin-chart-data-value="<%= Analytics::FunnelStages::ORDERED.map { |stage| @funnel_counts[stage] }.to_json %>"
         data-raw-stages-test="<%= Analytics::FunnelStages::ORDERED.to_json %>">
      <canvas data-admin-chart-target="canvas"></canvas>
    </div>
  </div>
</div>
