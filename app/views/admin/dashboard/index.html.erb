<div class="admin-dashboard">
  <header class="admin-dashboard__header">
    <h1 class="admin-dashboard__title"><%= t("admin.dashboard.title") %></h1>
    <p class="admin-dashboard__tagline"><%= t("admin.dashboard.tagline") %></p>
  </header>

  <div class="admin-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin-top: 2rem;">
    <div class="admin-panel" style="display: flex; flex-direction: column; justify-content: space-between; gap: 1.5rem;">
      <div>
        <h2 class="admin-panel__title" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
          <span><%= t("admin.dashboard.ventas.title") %></span>
          <span class="badge badge--succeeded"><%= t("admin.dashboard.active_badge") %></span>
        </h2>
        <p style="color: var(--fit-text-muted, #5c6d82); font-size: 0.9rem; line-height: 1.5; margin: 0;">
          <%= t("admin.dashboard.ventas.description") %>
        </p>
      </div>
      <%= link_to t("admin.dashboard.ventas.cta"), admin_ventas_path, class: "btn btn-primary", style: "text-decoration: none; text-align: center; display: block; width: 100%; padding: 0.5rem; font-weight: 500;" %>
    </div>

    <div class="admin-panel" style="display: flex; flex-direction: column; justify-content: space-between; gap: 1.5rem;">
      <div>
        <h2 class="admin-panel__title" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
          <span><%= t("admin.dashboard.analytics.title") %></span>
          <span class="badge badge--succeeded"><%= t("admin.dashboard.active_badge") %></span>
        </h2>
        <p style="color: var(--fit-text-muted, #5c6d82); font-size: 0.9rem; line-height: 1.5; margin: 0;">
          <%= t("admin.dashboard.analytics.description") %>
        </p>
      </div>
      <%= link_to t("admin.dashboard.analytics.cta"), admin_analytics_path, class: "btn btn-primary", style: "text-decoration: none; text-align: center; display: block; width: 100%; padding: 0.5rem; font-weight: 500;" %>
    </div>
  </div>
</div>
