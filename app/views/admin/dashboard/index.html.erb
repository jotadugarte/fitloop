<div class="admin-dashboard">
  <header class="admin-dashboard__header">
    <h1 class="admin-dashboard__title">Panel de administración</h1>
    <p class="admin-dashboard__tagline">Bienvenido/a. Selecciona una sección:</p>
  </header>

  <div class="admin-grid">
    <!-- Ventas Card (Visually Disabled) -->
    <div class="panel panel--solid admin-card">
      <div>
        <h2 class="admin-card__title">
          <span>Ventas</span>
          <span class="admin-card__badge">Próximamente</span>
        </h2>
        <p class="admin-card__description">Monitoreo de ingresos, facturación y reportes de ventas integrados con la pasarela de pagos.</p>
      </div>
      <span class="btn btn-secondary btn--compact admin-card__btn-disabled">Ir a Ventas</span>
    </div>

    <!-- Analytics Card (Visually Disabled) -->
    <div class="panel panel--solid admin-card">
      <div>
        <h2 class="admin-card__title">
          <span>Analytics</span>
          <span class="admin-card__badge">Próximamente</span>
        </h2>
        <p class="admin-card__description">Estadísticas de uso del optimizador, volumen de DXFs procesados y métricas de retención de usuarios.</p>
      </div>
      <span class="btn btn-secondary btn--compact admin-card__btn-disabled">Ir a Analytics</span>
    </div>
  </div>
</div>

