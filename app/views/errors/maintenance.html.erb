<% content_for(:title, t("maintenance.title")) %>

<div class="auth-page auth-page--maintenance" style="width: 100%; max-width: 440px; margin: 4rem auto; display: flex; flex-direction: column; align-items: center;">
  <!-- Glassmorphism Card -->
  <div style="background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid var(--fit-border-strong); border-radius: 24px; padding: 2.5rem 2rem; width: 100%; box-shadow: 0 12px 32px rgba(30, 58, 95, 0.08); text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.5rem; position: relative; overflow: hidden;">

    <!-- Decorative Glowing Laser Line at Top -->
    <div style="position: absolute; top: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, var(--fit-navy) 0%, var(--fit-navy-light) 50%, var(--fit-gold) 100%);"></div>

    <!-- Pulsing Animated Laser Icon -->
    <div class="maintenance-icon" style="width: 72px; height: 72px; border-radius: 50%; background: color-mix(in srgb, var(--fit-navy-light) 12%, transparent); display: flex; align-items: center; justify-content: center; position: relative;">
      <!-- Pulsing Ring -->
      <div style="position: absolute; width: 100%; height: 100%; border-radius: 50%; border: 2px solid var(--fit-navy-light); animation: pulse 2s infinite ease-in-out;"></div>
      <!-- Core Icon (SVG representing a gear/maintenance) -->
      <svg style="width: 36px; height: 36px; fill: var(--fit-navy);" viewBox="0 0 24 24">
        <path d="M19.43 12.98c.04-.32.07-.64.07-.98s-.03-.66-.07-.98l2.11-1.65c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.39-.3-.61-.22l-2.49 1c-.52-.4-1.08-.73-1.69-.98l-.38-2.65C14.46 2.18 14.25 2 14 2h-4c-.25 0-.46.18-.49.42l-.38 2.65c-.61.25-1.17.59-1.69.98l-2.49-1c-.23-.09-.49 0-.61.22l-2 3.46c-.13.22-.07.49.12.64l2.11 1.65c-.04.32-.07.65-.07.98s.03.66.07.98l-2.11 1.65c-.19.15-.24.42-.12.64l2 3.46c.12.22.39.3.61.22l2.49-1c.52.4 1.08.73 1.69.98l.38 2.65c.03.24.24.42.49.42h4c.25 0 .46-.18.49-.42l.38-2.65c.61-.25 1.17-.59 1.69-.98l2.49 1c.23.09.49 0 .61-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.65zM12 15.5c-1.93 0-3.5-1.57-3.5-3.5s1.57-3.5 3.5-3.5 3.5 1.57 3.5 3.5-1.57 3.5-3.5 3.5z"/>
      </svg>
    </div>

    <!-- Title and message -->
    <div>
      <h1 style="font-size: 1.75rem; font-weight: 700; color: var(--fit-navy); margin: 0 0 0.75rem;"><%= t("maintenance.title") %></h1>
      <p style="font-size: 1rem; color: var(--fit-text-muted); line-height: 1.6; margin: 0;"><%= t("maintenance.message") %></p>
    </div>

    <!-- Bottom Badge/Status -->
    <div style="margin-top: 1rem; width: 100%; padding: 0.85rem 1.25rem; background: var(--fit-bg); border-radius: 12px; border: 1px solid var(--fit-border); display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
      <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #e09f26; animation: blink 1.5s infinite ease-in-out;"></span>
      <span style="font-size: 0.85rem; font-weight: 600; color: var(--fit-text-muted); text-transform: uppercase; letter-spacing: 0.05em;">
        <%= I18n.locale == :es ? "503 Servicio En Mantenimiento" : "503 Service Under Maintenance" %>
      </span>
    </div>
  </div>
</div>

<style>
  @keyframes pulse {
    0% {
      transform: scale(0.95);
      opacity: 0.8;
    }
    50% {
      transform: scale(1.15);
      opacity: 0.2;
    }
    100% {
      transform: scale(0.95);
      opacity: 0.8;
    }
  }
  @keyframes blink {
    0% { opacity: 0.4; }
    50% { opacity: 1; }
    100% { opacity: 0.4; }
  }
</style>
