<%# locals: (project:, attachment:) %>
<% layers = project.project_layers.where(active_storage_attachment_id: attachment.id).order(:layer_name) %>
<% primary_layer = layers.find { |layer| layer.layer_role == "primary" } %>

<section class="dxf-file-layers panel panel--inset"
         data-testid="dxf-file-layers"
         data-attachment-id="<%= attachment.id %>">
  <h3 class="dxf-file-layers__title"><%= attachment.filename %></h3>

  <% if layers.any? %>
    <fieldset class="layer-primary-fieldset">
      <legend class="layer-primary-fieldset__legend">
        <%= t("project_layers.primary_layer.label") %>
        <span class="layer-primary-fieldset__hint"
              title="<%= t("project_layers.primary_layer.tooltip") %>"
              aria-label="<%= t("project_layers.primary_layer.tooltip") %>">?</span>
      </legend>
      <ul class="layer-list layer-list--visual layer-list--primary">
        <% layers.each do |layer| %>
          <li class="layer-list__item">
            <label class="layer-list__label layer-list__label--primary">
              <%= radio_button_tag "project_layers[#{attachment.id}][primary_layer_id]",
                                   layer.id,
                                   primary_layer&.id == layer.id,
                                   id: "primary_layer_#{attachment.id}_#{layer.id}",
                                   data: { testid: "primary-layer-radio" } %>
              <span class="layer-chip" style="--layer-chip-color: <%= layer_chip_color(layer) %>"></span>
              <span class="layer-list__name"><%= layer.layer_name %></span>
            </label>
          </li>
        <% end %>
      </ul>
    </fieldset>

    <h4 class="layer-auxiliary-heading"><%= t("project_layers.auxiliary_layers.label") %></h4>
    <p class="layer-auxiliary-heading__hint"><%= t("project_layers.auxiliary_layers.helper") %></p>
    <ul class="layer-list layer-list--visual">
      <% layers.each do |layer| %>
        <li class="layer-list__item">
          <label class="layer-list__label">
            <%= check_box_tag "project_layers[#{attachment.id}][#{layer.id}][auxiliary]",
                              "1",
                              layer.layer_role == "auxiliary" %>
            <span class="layer-chip" style="--layer-chip-color: <%= layer_chip_color(layer) %>"></span>
            <span class="layer-list__name"><%= layer.layer_name %></span>
          </label>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p><%= t("project_layers.index.empty") %></p>
  <% end %>
</section>
