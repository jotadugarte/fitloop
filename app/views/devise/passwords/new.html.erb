<%= render "devise/shared/auth_page", title: t("auth.password.forgot_title") do %>
  <p class="auth-page__intro"><%= t("auth.password.forgot_intro") %></p>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name),
        html: { method: :post, class: "auth-page__form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="field">
      <%= f.label :email %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
    </div>

    <div class="form-actions">
      <%= f.submit t("auth.password.send_reset"), class: "btn btn-primary" %>
    </div>
  <% end %>

  <nav class="auth-page__footer" aria-label="<%= t("auth.shared.footer_nav") %>">
    <%= link_to t("auth.nav.sign_in"), new_user_session_path, class: "auth-page__link" %>
  </nav>
<% end %>
