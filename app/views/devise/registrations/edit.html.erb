<%= render "devise/shared/auth_page", title: t("auth.account.title") do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
        html: { method: :put, class: "auth-page__form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="field">
      <%= f.label :email, t("auth.account.email") %>
      <%= f.email_field :email, autocomplete: "email" %>
    </div>

    <div class="field">
      <%= f.label :name, t("auth.account.name") %>
      <%= f.text_field :name, autocomplete: "name" %>
    </div>

    <div class="field">
      <%= f.label :password, t("auth.account.new_password") %>
      <%= f.password_field :password, autocomplete: "new-password" %>
      <span class="field__hint"><%= t("auth.account.new_password_hint") %></span>
    </div>

    <div class="field">
      <%= f.label :password_confirmation, t("auth.account.password_confirmation") %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
    </div>

    <div class="field">
      <%= f.label :current_password, t("auth.account.current_password") %>
      <%= f.password_field :current_password, autocomplete: "current-password" %>
      <span class="field__hint"><%= t("auth.account.current_password_hint") %></span>
    </div>

    <div class="form-actions">
      <%= f.submit t("auth.account.submit"), class: "btn btn-primary" %>
    </div>
  <% end %>

  <nav class="auth-page__footer" aria-label="<%= t("auth.shared.footer_nav") %>">
    <%= link_to t("auth.account_deletion.link"), account_deletion_path, class: "auth-page__link" %>
    <%= link_to t("auth.nav.payments"), mis_pagos_path, class: "auth-page__link" %>
  </nav>
<% end %>
