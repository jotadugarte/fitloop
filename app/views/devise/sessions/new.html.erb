<%= render "devise/shared/auth_page", title: t("auth.session.sign_in_title") do %>
  <section class="auth-page__email" data-testid="oauth-email">
    <%= form_for(resource, as: resource_name, url: session_path(resource_name),
          html: { class: "auth-page__form", data: { turbo: false } }) do |f| %>
      <%= render "devise/shared/auth_flash_alert" %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field">
        <%= f.label :email %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
      </div>

      <div class="field">
        <%= f.label :password, t("auth.session.password") %>
        <%= f.password_field :password, autocomplete: "current-password" %>
      </div>

      <div class="form-actions">
        <%= f.submit t("auth.session.submit"), class: "btn btn-primary" %>
      </div>
    <% end %>

    <nav class="auth-page__footer" aria-label="<%= t("auth.shared.footer_nav") %>">
      <%= link_to t("auth.password.forgot_title"), new_user_password_path, class: "auth-page__link" %>
      <%= link_to t("auth.nav.sign_up"), new_user_registration_path, class: "auth-page__link" %>
    </nav>
  </section>
<% end %>
