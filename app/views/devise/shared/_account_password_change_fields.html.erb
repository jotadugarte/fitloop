<%# locals: (f:) %>
<p class="field__hint auth-page__disclosure-intro"><%= t("auth.account.password_change_intro") %></p>

<div class="field">
  <%= f.label :current_password, t("auth.account.current_password") %>
  <%= f.password_field :current_password,
        autocomplete: "current-password",
        data: {
          password_validation_target: "currentPassword",
          action: "input->password-validation#validate change->password-validation#validate"
        } %>
  <span class="field__hint"><%= t("auth.account.current_password_hint") %></span>
</div>

<div class="field">
  <%= f.label :password, t("auth.account.new_password") %>
  <%= f.password_field :password,
        autocomplete: "new-password",
        aria: { describedby: "account-password-validation-messages" },
        data: {
          password_validation_target: "password",
          action: "input->password-validation#validate change->password-validation#validate"
        } %>
  <span
    class="field__hint"
    id="account-password-validation-messages"
    data-password-validation-target="lengthHint"
  ><%= auth_password_length_hint %></span>
  <p
    class="field__validation-msg field__validation-msg--error"
    data-password-validation-target="lengthError"
    role="status"
    aria-live="polite"
    hidden
  ></p>
</div>

<div class="field">
  <%= f.label :password_confirmation, t("auth.account.password_confirmation") %>
  <%= f.password_field :password_confirmation,
        autocomplete: "new-password",
        data: {
          password_validation_target: "confirmation",
          action: "input->password-validation#validate change->password-validation#validate"
        } %>
  <p
    class="field__validation-msg"
    data-password-validation-target="matchFeedback"
    role="status"
    aria-live="polite"
    hidden
  ></p>
</div>
