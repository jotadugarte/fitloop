<%# locals: (f:) %>
<div class="auth-page__password-fields">
  <div class="field">
    <%= f.label :password %>
    <%= f.password_field :password,
          autocomplete: "new-password",
          aria: { describedby: "password-validation-messages" },
          data: {
            password_validation_target: "password",
            action: "input->password-validation#validate"
          } %>
    <span class="field__hint"><%= auth_password_length_hint %></span>
    <p
      class="field__validation-msg field__validation-msg--error"
      id="password-validation-messages"
      data-password-validation-target="lengthError"
      role="status"
      aria-live="polite"
      hidden
    ></p>
  </div>

  <div class="field">
    <%= f.label :password_confirmation %>
    <%= f.password_field :password_confirmation,
          autocomplete: "new-password",
          data: {
            password_validation_target: "confirmation",
            action: "input->password-validation#validate"
          } %>
    <p
      class="field__validation-msg field__validation-msg--error"
      data-password-validation-target="matchError"
      role="status"
      aria-live="polite"
      hidden
    ></p>
    <p
      class="field__validation-msg field__validation-msg--ok"
      data-password-validation-target="matchOk"
      role="status"
      aria-live="polite"
      hidden
    ></p>
  </div>
</div>
