<article class="auth-page panel panel--chrome" data-testid="auth-page">
  <header class="auth-page__header">
    <%= link_to auth_back_label,
                auth_back_path,
                class: "btn btn-secondary auth-page__back",
                data: { testid: "auth-back", turbo_frame: "_top" } %>
    <%= image_tag "/images/logo.png", alt: t("application.name"), class: "auth-page__logo" %>
  </header>

  <h1 class="auth-page__title"><%= title %></h1>

  <%= yield %>
</article>
